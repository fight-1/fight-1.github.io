---
// =========================================
// Fight-1 — Main Page
// Tri-State Self: Mirror | Version | Loop
// Real data integration
// =========================================
import '../styles/global.css';
import MeteorLayer from '../components/MeteorLayer.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import ThemeIndicator from '../components/ThemeIndicator.astro';
import GitHubData from '../components/GitHubData.astro';

// Content data — static text only
const profile = {
  location: 'Earth, Milky Way',
  about: [
    'Treat myself as an open-source project — always iterating, never finished.',
    'Today I beat yesterday\'s limits. Tomorrow, I push further.',
    'This is not a portfolio. It\'s a living log of self-improvement.',
  ],
  patchNotes: [
    { version: 'v26.09', date: '2026-09', changes: [
      { type: 'add', text: 'New skill tree: Systems Architecture' },
      { type: 'fix', text: 'Procrastination bug in weekend builds' },
      { type: 'perf', text: 'Optimized learning pipeline — 2x throughput' },
      { type: 'warn', text: 'Coffee dependency remains unresolved' },
    ]},
    { version: 'v26.03', date: '2026-03', changes: [
      { type: 'add', text: 'Launched first open-source contribution' },
      { type: 'fix', text: 'Fixed imposter syndrome (temporary)' },
      { type: 'nerf', text: 'Nerfed: doom-scrolling capability' },
    ]},
    { version: 'v25.09', date: '2025-09', changes: [
      { type: 'add', text: 'System initialized — first commit' },
      { type: 'add', text: 'Core loop established: Reflect → Build → Evolve' },
    ]},
  ],
  skills: [
    { name: 'JavaScript/TypeScript', level: 90, category: 'core' },
    { name: 'Python', level: 75, category: 'core' },
    { name: 'Rust', level: 55, category: 'growing' },
    { name: 'React/Vue', level: 80, category: 'core' },
    { name: 'Astro', level: 85, category: 'core' },
    { name: 'System Design', level: 60, category: 'growing' },
    { name: 'DevOps', level: 50, category: 'growing' },
    { name: 'AI/ML', level: 45, category: 'exploring' },
  ],
  projects: [
    {
      name: 'self-refactor-core',
      description: 'The internal framework. Refactoring my own patterns, one habit at a time.',
      tags: ['life', 'philosophy', 'iterative'],
      status: 'wip',
      stars: '∞',
      updated: 'Just now',
    },
    {
      name: 'pixel-forge',
      description: 'Generative art engine — turning algorithms into visual stories.',
      tags: ['creative-coding', 'canvas', 'webgl'],
      status: 'won',
      stars: '★ 42',
      updated: '2026-08-15',
    },
    {
      name: 'data-nexus',
      description: 'Real-time data visualization dashboard for personal metrics.',
      tags: ['visualization', 'react', 'd3'],
      status: 'learned',
      stars: '★ 28',
      updated: '2026-06-20',
    },
    {
      name: 'echo-protocol',
      description: 'A messaging experiment that taught me about network patterns.',
      tags: ['networking', 'rust', 'learning'],
      status: 'learned',
      stars: '★ 15',
      updated: '2026-04-10',
    },
    {
      name: 'void-runner',
      description: 'Roguelike game prototype — failed beautifully, learned immensely.',
      tags: ['game-dev', 'rust', 'learning'],
      status: 'loss',
      stars: '★ 8',
      updated: '2026-01-05',
    },
  ],
  philosophy: [
    { title: 'Reflect', icon: '🔄', desc: 'Question assumptions, analyze patterns, understand the why.' },
    { title: 'Build', icon: '🔨', desc: 'Ship things. Imperfect action beats perfect inaction every time.' },
    { title: 'Evolve', icon: '🧬', desc: 'Integrate lessons. The new version is always better than the last.' },
  ],
  cta: {
    title: 'Challenge Me',
    description: 'Found a bug in my thinking? Want to build something together?',
    email: 'hello@fight-1.dev',
    github: 'fight-1',
  },
};
---

<!doctype html>
<html lang="en" data-theme="mirror">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fight-1 — Tri-State Self. Me against Me, for Me. A living portfolio of reflection, building, and evolution." />
    <meta name="theme-color" content="#09090b" />

    <!-- Open Graph -->
    <meta property="og:title" content="Fight-1 | Tri-State Self" />
    <meta property="og:description" content="Me against Me, for Me. A living portfolio of self-evolution." />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <title>Fight-1 — Tri-State Self</title>

    <style is:global>
      /* ===== New Features (2026-09-07) ===== */
      .glitch { position: relative; animation: glitchShift 3.6s infinite; }
      @keyframes glitchShift {
        0%, 90%, 100% { text-shadow: none; transform: none; }
        92% { text-shadow: 2px 0 var(--accent-2), -2px 0 var(--accent-1); transform: translateX(1px); }
        94% { text-shadow: -2px 0 var(--accent-2), 2px 0 var(--accent-1); transform: translateX(-1px); }
        96% { text-shadow: 2px 0 var(--accent-2), -2px 0 var(--accent-1); transform: translateX(1px); }
      }

      .section-badge {
        font-size: 0.6rem; font-family: 'JetBrains Mono', monospace;
        padding: 0.2rem 0.6rem; border: 1px solid var(--accent-1);
        border-radius: 999px; color: var(--accent-1); margin-left: 0.6rem; vertical-align: middle;
        opacity: 0.85;
      }

      /* State Lens tabs */
      .state-lens-tabs { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
      .state-lens-tab {
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
        color: #cbd5e1; padding: 0.5rem 1rem; border-radius: 999px; cursor: pointer;
        font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; transition: all 0.25s;
      }
      .state-lens-tab:hover { border-color: var(--accent-1); }
      .state-lens-tab.active { background: var(--accent-1); color: #0b0b0f; border-color: var(--accent-1); font-weight: 600; }
      .state-lens-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
      .state-lens-panel[hidden] { display: none; }
      .lens-col h4, .state-lens-panel h4 { color: #e2e8f0; font-size: 0.95rem; margin-bottom: 0.75rem; font-family: 'Space Grotesk', sans-serif; }
      .lens-note { color: #64748b; font-size: 0.8rem; margin-top: 0.5rem; }
      .lens-empty { color: #64748b; font-size: 0.9rem; }

      .heatmap { display: grid; grid-template-columns: repeat(17, 1fr); gap: 3px; }
      .hm-cell { aspect-ratio: 1; border-radius: 2px; background: rgba(255,255,255,0.05); }
      .hm-1 { background: rgba(0,243,255,0.3); }
      .hm-2 { background: rgba(0,243,255,0.5); }
      .hm-3 { background: rgba(0,243,255,0.72); }
      .hm-4 { background: var(--accent-1); box-shadow: 0 0 6px var(--accent-1); }

      .lang-row { display: grid; grid-template-columns: 90px 1fr 30px; align-items: center; gap: 0.5rem; margin-bottom: 0.55rem; }
      .lang-name { color: #cbd5e1; font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .lang-bar { height: 6px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden; }
      .lang-fill { height: 100%; background: linear-gradient(90deg, var(--accent-1), var(--accent-2)); border-radius: 999px; }
      .lang-val { color: #64748b; font-size: 0.75rem; text-align: right; }

      .growth-wrap { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 1rem; }
      .growth-svg { width: 100%; height: 120px; display: block; }
      .activity-list { display: flex; flex-direction: column; gap: 0.5rem; max-height: 320px; overflow-y: auto; }
      .act-row { display: grid; grid-template-columns: 110px 1fr auto; gap: 0.75rem; align-items: center;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.82rem; }
      .act-type { color: var(--accent-1); font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; }
      .act-repo { color: #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .act-when { color: #64748b; font-size: 0.72rem; }

      /* Repo picker + timeline */
      .repo-picker { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
      .repo-picker input { flex: 1; min-width: 220px; background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.12); color: #e2e8f0; padding: 0.6rem 0.9rem; border-radius: 8px;
        font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; }
      .repo-picker input:focus { outline: none; border-color: var(--accent-1); }
      .timeline { position: relative; padding-left: 1.5rem; border-left: 2px solid rgba(255,255,255,0.1); }
      .tl-item { position: relative; margin-bottom: 1.25rem; }
      .tl-dot { position: absolute; left: -1.85rem; top: 0.3rem; width: 12px; height: 12px; border-radius: 50%;
        background: var(--accent-1); box-shadow: 0 0 8px var(--accent-1); }
      .tl-latest .tl-dot { background: var(--accent-2); box-shadow: 0 0 10px var(--accent-2); }
      .tl-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 0.85rem 1rem; }
      .tl-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem; }
      .tl-ver { color: var(--accent-1); font-family: 'JetBrains Mono', monospace; font-weight: 600; }
      .tl-date { color: #64748b; font-size: 0.75rem; }
      .tl-body { color: #cbd5e1; font-size: 0.82rem; white-space: pre-wrap; max-height: 140px; overflow: auto; }

      /* Achievements */
      .badge-wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem; }
      .badge { background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15); border-radius: 12px;
        padding: 1rem; text-align: center; opacity: 0.45; filter: grayscale(1); transition: all 0.3s; }
      .badge-on { opacity: 1; filter: none; border-style: solid; border-color: var(--accent-1);
        box-shadow: 0 0 18px rgba(0,243,255,0.15); background: rgba(0,243,255,0.06); }
      .badge-icon { font-size: 1.8rem; margin-bottom: 0.4rem; }
      .badge-name { color: #e2e8f0; font-weight: 600; font-size: 0.9rem; }
      .badge-desc { color: #64748b; font-size: 0.72rem; margin-top: 0.25rem; }

      /* NPC bubble */
      .npc-bubble { position: fixed; left: 50%; bottom: 2rem; transform: translateX(-50%) translateY(20px);
        background: rgba(10,10,15,0.95); border: 1px solid var(--accent-1); color: #e2e8f0;
        padding: 0.75rem 1.1rem; border-radius: 12px; max-width: 80vw; font-size: 0.9rem;
        box-shadow: 0 0 24px rgba(0,243,255,0.2); opacity: 0; pointer-events: none; transition: all 0.35s; z-index: 9997; }
      .npc-bubble.show { opacity: 1; transform: translateX(-50%) translateY(0); }

      /* Share modal */
      .share-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: none; align-items: center; justify-content: center; z-index: 9999; }
      .share-modal.open { display: flex; }
      .share-modal-inner { background: #0b0b0f; border: 1px solid var(--accent-1); border-radius: 16px; padding: 1.5rem; text-align: center; position: relative; }
      .share-modal-inner h3 { color: #e2e8f0; margin-bottom: 1rem; font-family: 'Space Grotesk', sans-serif; }
      .share-modal-inner canvas { width: 300px; height: auto; border-radius: 8px; max-width: 80vw; }
      .share-close { position: absolute; top: 0.5rem; right: 0.75rem; background: none; border: none; color: #94a3b8; font-size: 1.5rem; cursor: pointer; }
      .share-modal-inner .cta-btn { display: inline-block; margin-top: 1rem; }

      /* Toast */
      .fight-toast { position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%) translateY(-20px);
        background: rgba(10,10,15,0.95); border: 1px solid var(--accent-2); color: #fff; padding: 0.7rem 1.2rem;
        border-radius: 10px; font-size: 0.9rem; z-index: 10000; opacity: 0; transition: all 0.35s; box-shadow: 0 0 20px rgba(255,0,255,0.2); }
      .fight-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

      .footer-challenger { color: var(--accent-1); font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; }

      @media (max-width: 768px) {
        .state-lens-panel { grid-template-columns: 1fr; }
        .heatmap { grid-template-columns: repeat(12, 1fr); }
      }

      /* Preset palettes + auto cycle */
      .color-label-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.5rem; }
      .auto-toggle { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; color: #cbd5e1; cursor: pointer; white-space: nowrap; }
      .auto-toggle input { accent-color: var(--accent-1); cursor: pointer; }
      .preset-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; }
      .preset-swatch { display: flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.4rem;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px;
        cursor: pointer; transition: all 0.25s; text-align: left; }
      .preset-swatch:hover { border-color: var(--accent-1); background: rgba(255,255,255,0.06); }
      .preset-swatch.active { border-color: var(--accent-1); background: rgba(255,255,255,0.08); }
      .preset-chip { width: 18px; height: 18px; border-radius: 4px; flex: 0 0 auto; box-shadow: 0 0 6px rgba(0,0,0,0.5); }
      .preset-name { font-size: 0.68rem; color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    </style>
  </head>

  <body class="min-h-screen">
    <!-- Cursor Glow Effect -->
    <div class="cursor-glow" aria-hidden="true"></div>

    <!-- Meteor / falling layer (per-theme) -->
    <MeteorLayer />

    <!-- Particle Background -->
    <ParticleBackground />

    <!-- Theme Indicator (always visible) -->
    <ThemeIndicator />

    <!-- ====== HEADER / HERO ====== -->
    <header class="hero-section" data-lock-theme="mirror">
      <div class="hero-content">
        <!-- Status badge -->
        <div class="hero-badge animate-fade-in-up">
          <span class="status-dot"></span>
          <span class="status-text">{profile.location}</span>
        </div>

        <!-- Main heading -->
        <h1 class="hero-title animate-fade-in-up" style="animation-delay: 0.1s;">
          <span class="gradient-text" id="hero-username"></span>
        </h1>

        <!-- Avatar (real GitHub avatar_url; offline fallback applied via JS) -->
        <img id="hero-avatar" alt="" style="width:80px;height:80px;border-radius:50%;border:3px solid var(--accent-1);margin-bottom:1rem;display:none;box-shadow:0 0 20px rgba(0,243,255,0.3);" class="animate-fade-in-up" />

        <!-- Tagline -->
        <p class="hero-tagline animate-fade-in-up" style="animation-delay: 0.2s;">
          <span id="hero-tagline">Me against Me, for Me.</span>
        </p>

        <!-- Short description (bio from GitHub) -->
        <p class="hero-desc animate-fade-in-up" style="animation-delay: 0.3s;">
          <span id="hero-bio">Self vs Self. Evolution guaranteed.</span>
        </p>

        <!-- Theme label -->
        <div class="theme-label animate-fade-in-up" style="animation-delay: 0.4s;">
          <span class="theme-label-text"></span>
          <span class="theme-label-hint">Press T to cycle</span>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-indicator animate-fade-in-up" style="animation-delay: 0.6s;">
        <div class="scroll-mouse">
          <div class="scroll-wheel"></div>
        </div>
        <span>Scroll to explore</span>
      </div>
    </header>

    <!-- ====== PHILOSOPHY CYCLE ====== -->
    <section class="philosophy-section" data-lock-theme="loop">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">01</span>
          The Loop
        </h2>

        <div class="philosophy-grid section-fade-in">
          {profile.philosophy.map((item, i) => (
            <div class="philosophy-card" style="animation-delay: {i * 0.15}s;">
              <div class="philosophy-icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              <div class="philosophy-arrow">
                {i < profile.philosophy.length - 1 ? '→' : '↻'}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== ABOUT / PATCH NOTES ====== -->
    <section class="about-section" data-lock-theme="version">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">02</span>
          Patch Notes
        </h2>

        <div class="about-grid">
          <!-- About text -->
          <div class="about-text section-fade-in">
            {profile.about.map((text) => (
              <p class="about-paragraph">{text}</p>
            ))}
          </div>

          <!-- Changelog -->
          <div class="changelog section-fade-in" id="changelog">
            {profile.patchNotes.map((note) => (
              <div class="changelog-entry">
                <div class="changelog-header">
                  <span class="changelog-version">{note.version}</span>
                  <span class="changelog-date">{note.date}</span>
                </div>
                <ul class="changelog-list">
                  {note.changes.map((change) => (
                    <li class="changelog-item">
                      <span class={`change-badge change-${change.type}`}>
                        {change.type === 'add' ? '+ Added' :
                         change.type === 'fix' ? '⚑ Fixed' :
                         change.type === 'perf' ? '⚡ Perf' :
                         change.type === 'nerf' ? '🔻 Nerfed' :
                         change.type === 'warn' ? '⚠ Known' : change.type}
                      </span>
                      <span>{change.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ====== SKILLS / LOADOUT ====== -->
    <section class="skills-section" data-lock-theme="mirror">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">03</span>
          Weapon Loadout
        </h2>

        <div class="skills-grid section-fade-in">
          {profile.skills.map((skill) => (
            <div class="skill-card">
              <div class="skill-header">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-level">{skill.level}%</span>
              </div>
              <div class="bar-container">
                <div
                  class="bar-fill accent-1-gradient"
                  style="width: 0%;"
                  data-width={skill.level}
                ></div>
              </div>
              <span class="skill-category">{skill.category}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== PROJECTS / BATTLE LOG ====== -->
    <section class="projects-section" data-lock-theme="loop">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">04</span>
          Battle Log
        </h2>

        <div class="projects-grid section-fade-in" id="projects-grid">
          {profile.projects.map((project) => (
            <div class="project-card">
              <div class="project-header">
                <div class="project-icon">📁</div>
                <div class="project-status-badge status-{project.status}">
                  {project.status === 'won' ? '✓ Won' :
                   project.status === 'learned' ? '⟳ Learned' :
                   project.status === 'loss' ? '✗ Lost' : '◌ WIP'}
                </div>
              </div>
              <h3 class="project-name">
                <a href={`https://github.com/${profile.github}/${project.name}`} target="_blank" rel="noopener">
                  {project.name}
                </a>
              </h3>
              <p class="project-desc">{project.description}</p>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <div class="project-footer">
                <span class="project-stars">{project.stars}</span>
                <span class="project-updated">Updated {project.updated}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== STATS / GROWTH METRICS ====== -->
    <section class="stats-section" data-lock-theme="version">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">05</span>
          Growth Metrics
        </h2>

        <div class="stats-grid section-fade-in" id="stats-grid">
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-commits">—</div>
            <div class="stat-label">Recent Commits</div>
          </div>
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-streak">—</div>
            <div class="stat-label">Active Days</div>
          </div>
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-langs">—</div>
            <div class="stat-label">Public Repos</div>
          </div>
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-loc">—</div>
            <div class="stat-label">Followers</div>
          </div>
          <div class="stat-card stat-card-highlight">
            <div class="stat-value gradient-text" id="stat-current-streak">—</div>
            <div class="stat-label">Current Streak 🔥</div>
          </div>
          <div class="stat-card stat-card-highlight">
            <div class="stat-value gradient-text" id="stat-stars">—</div>
            <div class="stat-label">Total Stars</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== CTA / CONTACT ====== -->
    <section class="cta-section" data-lock-theme="loop">
      <div class="container">
        <div class="cta-card section-fade-in">
          <h2>{profile.cta.title}</h2>
          <p>{profile.cta.description}</p>
          <div class="cta-buttons">
            <a
              href="https://fight-1.github.io/"
              target="_blank"
              rel="noopener"
              class="cta-btn cta-btn-primary"
              id="cta-github"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
