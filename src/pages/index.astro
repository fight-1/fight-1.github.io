---
// =========================================
// Fight-1 — Main Page
// Tri-State Self: Mirror | Version | Loop
// Real data integration
// =========================================
import '../styles/global.css';
import ParticleBackground from '../components/ParticleBackground.astro';
import ThemeIndicator from '../components/ThemeIndicator.astro';
import GitHubData from '../components/GitHubData.astro';

// Content data — static text only
const profile = {
  location: 'Earth, Milky Way',
  about: [
    'Treat myself as an open-source project — always iterating, never finished.',
    'Today I beat yesterday\'s limits. Tomorrow, I push further.',
    'This is not a portfolio. It\'s a living log of self-improvement.',
  ],
  patchNotes: [
    { version: 'v26.09', date: '2026-09', changes: [
      { type: 'add', text: 'New skill tree: Systems Architecture' },
      { type: 'fix', text: 'Procrastination bug in weekend builds' },
      { type: 'perf', text: 'Optimized learning pipeline — 2x throughput' },
      { type: 'warn', text: 'Coffee dependency remains unresolved' },
    ]},
    { version: 'v26.03', date: '2026-03', changes: [
      { type: 'add', text: 'Launched first open-source contribution' },
      { type: 'fix', text: 'Fixed imposter syndrome (temporary)' },
      { type: 'nerf', text: 'Nerfed: doom-scrolling capability' },
    ]},
    { version: 'v25.09', date: '2025-09', changes: [
      { type: 'add', text: 'System initialized — first commit' },
      { type: 'add', text: 'Core loop established: Reflect → Build → Evolve' },
    ]},
  ],
  skills: [
    { name: 'JavaScript/TypeScript', level: 90, category: 'core' },
    { name: 'Python', level: 75, category: 'core' },
    { name: 'Rust', level: 55, category: 'growing' },
    { name: 'React/Vue', level: 80, category: 'core' },
    { name: 'Astro', level: 85, category: 'core' },
    { name: 'System Design', level: 60, category: 'growing' },
    { name: 'DevOps', level: 50, category: 'growing' },
    { name: 'AI/ML', level: 45, category: 'exploring' },
  ],
  projects: [
    {
      name: 'self-refactor-core',
      description: 'The internal framework. Refactoring my own patterns, one habit at a time.',
      tags: ['life', 'philosophy', 'iterative'],
      status: 'wip',
      stars: '∞',
      updated: 'Just now',
    },
    {
      name: 'pixel-forge',
      description: 'Generative art engine — turning algorithms into visual stories.',
      tags: ['creative-coding', 'canvas', 'webgl'],
      status: 'won',
      stars: '★ 42',
      updated: '2026-08-15',
    },
    {
      name: 'data-nexus',
      description: 'Real-time data visualization dashboard for personal metrics.',
      tags: ['visualization', 'react', 'd3'],
      status: 'learned',
      stars: '★ 28',
      updated: '2026-06-20',
    },
    {
      name: 'echo-protocol',
      description: 'A messaging experiment that taught me about network patterns.',
      tags: ['networking', 'rust', 'learning'],
      status: 'learned',
      stars: '★ 15',
      updated: '2026-04-10',
    },
    {
      name: 'void-runner',
      description: 'Roguelike game prototype — failed beautifully, learned immensely.',
      tags: ['game-dev', 'rust', 'learning'],
      status: 'loss',
      stars: '★ 8',
      updated: '2026-01-05',
    },
  ],
  philosophy: [
    { title: 'Reflect', icon: '🔄', desc: 'Question assumptions, analyze patterns, understand the why.' },
    { title: 'Build', icon: '🔨', desc: 'Ship things. Imperfect action beats perfect inaction every time.' },
    { title: 'Evolve', icon: '🧬', desc: 'Integrate lessons. The new version is always better than the last.' },
  ],
  cta: {
    title: 'Challenge Me',
    description: 'Found a bug in my thinking? Want to build something together?',
    email: 'hello@fight-1.dev',
    github: 'fight-1',
  },
};
---

<!doctype html>
<html lang="en" data-theme="mirror">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fight-1 — Tri-State Self. Me against Me, for Me. A living portfolio of reflection, building, and evolution." />
    <meta name="theme-color" content="#09090b" />

    <!-- Open Graph -->
    <meta property="og:title" content="Fight-1 | Tri-State Self" />
    <meta property="og:description" content="Me against Me, for Me. A living portfolio of self-evolution." />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <title>Fight-1 — Tri-State Self</title>
  </head>

  <body class="min-h-screen">
    <!-- Cursor Glow Effect -->
    <div class="cursor-glow" aria-hidden="true"></div>

    <!-- Particle Background -->
    <ParticleBackground />

    <!-- Theme Indicator (always visible) -->
    <ThemeIndicator />

    <!-- ====== HEADER / HERO ====== -->
    <header class="hero-section" data-lock-theme="mirror">
      <div class="hero-content">
        <!-- Status badge -->
        <div class="hero-badge animate-fade-in-up">
          <span class="status-dot"></span>
          <span class="status-text">{profile.location}</span>
        </div>

        <!-- Main heading -->
        <h1 class="hero-title animate-fade-in-up" style="animation-delay: 0.1s;">
          <span class="gradient-text" id="hero-username"></span>
        </h1>

        <!-- Avatar (real GitHub avatar_url; offline fallback applied via JS) -->
        <img id="hero-avatar" alt="" style="width:80px;height:80px;border-radius:50%;border:3px solid var(--accent-1);margin-bottom:1rem;display:none;box-shadow:0 0 20px rgba(0,243,255,0.3);" class="animate-fade-in-up" />

        <!-- Tagline -->
        <p class="hero-tagline animate-fade-in-up" style="animation-delay: 0.2s;">
          <span id="hero-tagline">Me against Me, for Me.</span>
        </p>

        <!-- Short description (bio from GitHub) -->
        <p class="hero-desc animate-fade-in-up" style="animation-delay: 0.3s;">
          <span id="hero-bio">Self vs Self. Evolution guaranteed.</span>
        </p>

        <!-- Theme label -->
        <div class="theme-label animate-fade-in-up" style="animation-delay: 0.4s;">
          <span class="theme-label-text"></span>
          <span class="theme-label-hint">Press T to cycle</span>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-indicator animate-fade-in-up" style="animation-delay: 0.6s;">
        <div class="scroll-mouse">
          <div class="scroll-wheel"></div>
        </div>
        <span>Scroll to explore</span>
      </div>
    </header>

    <!-- ====== PHILOSOPHY CYCLE ====== -->
    <section class="philosophy-section" data-lock-theme="loop">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">01</span>
          The Loop
        </h2>

        <div class="philosophy-grid section-fade-in">
          {profile.philosophy.map((item, i) => (
            <div class="philosophy-card" style="animation-delay: {i * 0.15}s;">
              <div class="philosophy-icon">{item.icon}</div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              <div class="philosophy-arrow">
                {i < profile.philosophy.length - 1 ? '→' : '↻'}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== ABOUT / PATCH NOTES ====== -->
    <section class="about-section" data-lock-theme="version">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">02</span>
          Patch Notes
        </h2>

        <div class="about-grid">
          <!-- About text -->
          <div class="about-text section-fade-in">
            {profile.about.map((text) => (
              <p class="about-paragraph">{text}</p>
            ))}
          </div>

          <!-- Changelog -->
          <div class="changelog section-fade-in">
            {profile.patchNotes.map((note) => (
              <div class="changelog-entry">
                <div class="changelog-header">
                  <span class="changelog-version">{note.version}</span>
                  <span class="changelog-date">{note.date}</span>
                </div>
                <ul class="changelog-list">
                  {note.changes.map((change) => (
                    <li class="changelog-item">
                      <span class={`change-badge change-${change.type}`}>
                        {change.type === 'add' ? '+ Added' :
                         change.type === 'fix' ? '⚑ Fixed' :
                         change.type === 'perf' ? '⚡ Perf' :
                         change.type === 'nerf' ? '🔻 Nerfed' :
                         change.type === 'warn' ? '⚠ Known' : change.type}
                      </span>
                      <span>{change.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ====== SKILLS / LOADOUT ====== -->
    <section class="skills-section" data-lock-theme="mirror">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">03</span>
          Weapon Loadout
        </h2>

        <div class="skills-grid section-fade-in">
          {profile.skills.map((skill) => (
            <div class="skill-card">
              <div class="skill-header">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-level">{skill.level}%</span>
              </div>
              <div class="bar-container">
                <div
                  class="bar-fill accent-1-gradient"
                  style="width: 0%;"
                  data-width={skill.level}
                ></div>
              </div>
              <span class="skill-category">{skill.category}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== PROJECTS / BATTLE LOG ====== -->
    <section class="projects-section" data-lock-theme="loop">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">04</span>
          Battle Log
        </h2>

        <div class="projects-grid section-fade-in" id="projects-grid">
          {profile.projects.map((project) => (
            <div class="project-card">
              <div class="project-header">
                <div class="project-icon">📁</div>
                <div class="project-status-badge status-{project.status}">
                  {project.status === 'won' ? '✓ Won' :
                   project.status === 'learned' ? '⟳ Learned' :
                   project.status === 'loss' ? '✗ Lost' : '◌ WIP'}
                </div>
              </div>
              <h3 class="project-name">
                <a href={`https://github.com/${profile.github}/${project.name}`} target="_blank" rel="noopener">
                  {project.name}
                </a>
              </h3>
              <p class="project-desc">{project.description}</p>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <div class="project-footer">
                <span class="project-stars">{project.stars}</span>
                <span class="project-updated">Updated {project.updated}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== STATS / GROWTH METRICS ====== -->
    <section class="stats-section" data-lock-theme="version">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">05</span>
          Growth Metrics
        </h2>

        <div class="stats-grid section-fade-in" id="stats-grid">
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-commits">—</div>
            <div class="stat-label">Recent Commits</div>
          </div>
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-streak">—</div>
            <div class="stat-label">Active Days</div>
          </div>
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-langs">—</div>
            <div class="stat-label">Public Repos</div>
          </div>
          <div class="stat-card">
            <div class="stat-value gradient-text" id="stat-loc">—</div>
            <div class="stat-label">Followers</div>
          </div>
          <div class="stat-card stat-card-highlight">
            <div class="stat-value gradient-text" id="stat-current-streak">—</div>
            <div class="stat-label">Current Streak 🔥</div>
          </div>
          <div class="stat-card stat-card-highlight">
            <div class="stat-value gradient-text" id="stat-stars">—</div>
            <div class="stat-label">Total Stars</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== CTA / CONTACT ====== -->
    <section class="cta-section" data-lock-theme="loop">
      <div class="container">
        <div class="cta-card section-fade-in">
          <h2>{profile.cta.title}</h2>
          <p>{profile.cta.description}</p>
          <div class="cta-buttons">
            <a
              href={`https://github.com/${profile.cta.github}`}
              target="_blank"
              rel="noopener"
              class="cta-btn cta-btn-primary"
              id="cta-github"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View on GitHub
            </a>
            <a
              href={`mailto:${profile.cta.email}`}
              class="cta-btn cta-btn-secondary"
            >
              ✉ {profile.cta.email}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== LIVE GITHUB DATA ====== -->
    <section class="live-data-section" data-lock-theme="version">
      <div class="container">
        <h2 class="section-title section-fade-in">
          <span class="section-number">06</span>
          Live Data
          <span class="section-badge">🔌 GitHub API</span>
        </h2>
        <div class="section-fade-in">
          <GitHubData />
        </div>
      </div>
    </section>

    <!-- ====== FOOTER ====== -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-left">
            <span class="footer-name gradient-text" id="footer-username"></span>
            <span class="footer-sep">·</span>
            <span>Built with Astro + Tailwind</span>
          </div>
          <div class="footer-center">
            <span class="footer-theme-label"></span>
          </div>
          <div class="footer-right">
            <span class="footer-evolution">Evolving since 2025</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- ====== SCRIPTS ====== -->
    <script client:load>
      (function() {
        // =========================================
        // Theme Switcher Engine
        // =========================================
        var THEMES = ['mirror', 'version', 'loop'];
        var AUTO_SWITCH_INTERVAL = 15000;
        var MANUAL_PAUSE_DURATION = 30000;
        var currentIndex = 0;
        var autoTimer = null;
        var idleTimer = null;
        var isIdle = true;

        // Default colors per theme
        var DEFAULT_COLORS = {
          mirror: { accent1: '#00f3ff', accent2: '#ff00ff', hue: 270 },
          version: { accent1: '#00ff88', accent2: '#ffaa00', hue: 160 },
          loop: { accent1: null, accent2: null, hue: 270 }, // loop uses hue
        };

        var USERNAME = 'fight-1';

        // Offline-capable fallback avatar (initials), used until/below the real
        // GitHub avatar_url is fetched. Never leaves the avatar blank.
        var FALLBACK_SVG =
          "<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160' viewBox='0 0 160 160'>" +
          "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>" +
          "<stop offset='0' stop-color='#00f3ff'/><stop offset='1' stop-color='#ff00ff'/></linearGradient></defs>" +
          "<rect width='160' height='160' rx='80' fill='url(#g)'/>" +
          "<text x='80' y='80' dy='.35em' font-family='Arial,Helvetica,sans-serif' font-size='60' " +
          "font-weight='700' fill='#ffffff' text-anchor='middle'>F1</text></svg>";
        var FALLBACK_AVATAR = 'data:image/svg+xml,' + encodeURIComponent(FALLBACK_SVG);

        function setInitialState() {
          var stored = localStorage.getItem('fight1-theme');
          if (stored && THEMES.indexOf(stored) !== -1) {
            currentIndex = THEMES.indexOf(stored);
            return;
          }
          var now = new Date();
          var hour = now.getHours();
          var day = now.getDay();
          if (day === 0 || day === 6) currentIndex = 2;
          else if (hour >= 20 || hour < 6) currentIndex = 0;
          else currentIndex = 1;
        }

        function applyTheme(theme) {
          if (THEMES.indexOf(theme) === -1) return;
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('fight1-theme', theme);
          currentIndex = THEMES.indexOf(theme);

          document.querySelectorAll('.theme-dot').forEach(function(dot) {
            dot.classList.toggle('active', dot.dataset.theme === theme);
          });

          // Update custom colors
          applyCustomColors(theme);

          window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: theme } }));

          setTimeout(function() {
            document.documentElement.classList.remove('theme-transitioning');
          }, 700);
        }

        function applyCustomColors(theme) {
          var stored = localStorage.getItem('fight1-colors');
          var colors = stored ? JSON.parse(stored) : null;
          var themeColors = colors ? colors[theme] : null;

          if (!themeColors) {
            var defaults = DEFAULT_COLORS[theme];
            if (theme === 'loop') {
              document.documentElement.style.setProperty('--custom-hue', defaults.hue);
              document.documentElement.style.setProperty('--accent-1', 'hsl(' + defaults.hue + ', 80%, 68%)');
              document.documentElement.style.setProperty('--accent-2', 'hsl(' + (defaults.hue + 50) + ', 90%, 72%)');
            } else {
              document.documentElement.style.setProperty('--accent-1', defaults.accent1);
              document.documentElement.style.setProperty('--accent-2', defaults.accent2);
            }
            return;
          }

          if (theme === 'loop') {
            document.documentElement.style.setProperty('--custom-hue', themeColors.hue);
            document.documentElement.style.setProperty('--accent-1', 'hsl(' + themeColors.hue + ', 80%, 68%)');
            document.documentElement.style.setProperty('--accent-2', 'hsl(' + (themeColors.hue + 50) + ', 90%, 72%)');
          } else {
            document.documentElement.style.setProperty('--accent-1', themeColors.accent1 || DEFAULT_COLORS[theme].accent1);
            document.documentElement.style.setProperty('--accent-2', themeColors.accent2 || DEFAULT_COLORS[theme].accent2);
          }
        }

        function startAutoSwitch() {
          if (autoTimer) clearInterval(autoTimer);
          autoTimer = setInterval(function() {
            if (isIdle) {
              currentIndex = (currentIndex + 1) % THEMES.length;
              applyTheme(THEMES[currentIndex]);
            }
          }, AUTO_SWITCH_INTERVAL);
        }

        function stopAutoSwitch() {
          if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
        }

        function pauseAutoSwitch() {
          stopAutoSwitch();
          setTimeout(startAutoSwitch, MANUAL_PAUSE_DURATION);
        }

        function setupManualControls() {
          document.querySelectorAll('.theme-dot').forEach(function(dot) {
            dot.addEventListener('click', function() {
              var theme = dot.dataset.theme;
              if (!theme) return;
              applyTheme(theme);
              pauseAutoSwitch();
              dot.style.transform = 'scale(0.8)';
              setTimeout(function() { dot.style.transform = ''; }, 150);
            });
          });

          document.addEventListener('keydown', function(e) {
            if (e.key === 't' || e.key === 'T') {
              currentIndex = (currentIndex + 1) % THEMES.length;
              applyTheme(THEMES[currentIndex]);
              pauseAutoSwitch();
            }
          });
        }

        function setupIdleDetection() {
          var events = ['mousemove', 'keydown', 'scroll', 'click', 'touchstart'];
          events.forEach(function(event) {
            document.addEventListener(event, function() {
              isIdle = false;
              if (idleTimer) clearTimeout(idleTimer);
              idleTimer = setTimeout(function() { isIdle = true; }, 8000);
            }, { passive: true });
          });
        }

        // =========================================
        // Celebration: fireworks + hearts (replaces chaos mode)
        // Trigger: 8 clicks within 2 seconds
        // =========================================
        var celebrateCanvas = document.createElement('canvas');
        celebrateCanvas.id = 'celebrateCanvas';
        celebrateCanvas.style.cssText = 'position:fixed;inset:0;z-index:9998;pointer-events:none;';
        document.body.appendChild(celebrateCanvas);
        var cctx = celebrateCanvas.getContext('2d');
        var celebrateParticles = [];
        var celebrateHearts = [];
        var celebrateRAF = null;
        var HEART_COLORS = ['#ff5d8f', '#ff8fab', '#ff2d6f', '#ff9ec4', '#ff476f'];

        function resizeCelebrate() {
          var dpr = window.devicePixelRatio || 1;
          celebrateCanvas.width = window.innerWidth * dpr;
          celebrateCanvas.height = window.innerHeight * dpr;
          cctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resizeCelebrate();
        window.addEventListener('resize', resizeCelebrate);

        function spawnFirework(x, y) {
          var hue = Math.floor(Math.random() * 360);
          var count = 42 + Math.floor(Math.random() * 28);
          for (var i = 0; i < count; i++) {
            var angle = (Math.PI * 2) * (i / count) + Math.random() * 0.2;
            var speed = 2 + Math.random() * 4.5;
            celebrateParticles.push({
              x: x, y: y,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              life: 1, decay: 0.006 + Math.random() * 0.006,
              color: 'hsl(' + hue + ',90%,' + (55 + Math.random() * 15) + '%)',
              size: 2 + Math.random() * 2,
            });
          }
        }

        function spawnHeart(x, y) {
          celebrateHearts.push({
            x: x, y: y,
            vy: -(1 + Math.random() * 1.5),
            sway: Math.random() * Math.PI * 2,
            swaySpeed: 0.02 + Math.random() * 0.03,
            life: 1, decay: 0.0035 + Math.random() * 0.003,
            size: 16 + Math.random() * 18,
            color: HEART_COLORS[Math.floor(Math.random() * HEART_COLORS.length)],
          });
        }

        function drawHeart(ctx, x, y, size, color, alpha) {
          ctx.save();
          ctx.globalAlpha = alpha;
          ctx.fillStyle = color;
          ctx.translate(x, y);
          ctx.beginPath();
          var s = size / 16;
          ctx.moveTo(0, 4 * s);
          ctx.bezierCurveTo(-8 * s, -4 * s, -8 * s, -10 * s, 0, -4 * s);
          ctx.bezierCurveTo(8 * s, -10 * s, 8 * s, -4 * s, 0, 4 * s);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        function celebrateLoop() {
          var W = window.innerWidth, H = window.innerHeight;
          cctx.clearRect(0, 0, W, H);
          for (var i = celebrateParticles.length - 1; i >= 0; i--) {
            var p = celebrateParticles[i];
            p.x += p.vx; p.y += p.vy; p.vy += 0.05; p.vx *= 0.99; p.vy *= 0.99;
            p.life -= p.decay;
            if (p.life <= 0) { celebrateParticles.splice(i, 1); continue; }
            cctx.globalAlpha = Math.max(p.life, 0);
            cctx.fillStyle = p.color;
            cctx.beginPath();
            cctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            cctx.fill();
          }
          cctx.globalAlpha = 1;
          for (var j = celebrateHearts.length - 1; j >= 0; j--) {
            var h = celebrateHearts[j];
            h.sway += h.swaySpeed;
            h.x += Math.sin(h.sway) * 0.8;
            h.y += h.vy;
            h.life -= h.decay;
            if (h.life <= 0) { celebrateHearts.splice(j, 1); continue; }
            drawHeart(cctx, h.x, h.y, h.size, h.color, Math.max(h.life, 0));
          }
          if (celebrateParticles.length > 0 || celebrateHearts.length > 0) {
            celebrateRAF = requestAnimationFrame(celebrateLoop);
          } else {
            celebrateRAF = null;
            cctx.clearRect(0, 0, W, H);
          }
        }

        function launchCelebration() {
          var W = window.innerWidth, H = window.innerHeight;
          // Fireworks: a longer, staggered barrage so the show keeps going (~3.5s spread).
          var fwCount = 12;
          for (var k = 0; k < fwCount; k++) {
            (function(delay) {
              setTimeout(function() {
                spawnFirework(W * (0.12 + Math.random() * 0.76), H * (0.2 + Math.random() * 0.45));
              }, delay);
            })(k * 320);
          }
          // Hearts: stagger across the show so they keep floating up throughout (~3.5s spread).
          var heartCount = 26;
          for (var m = 0; m < heartCount; m++) {
            (function(delay) {
              setTimeout(function() {
                spawnHeart(W * Math.random(), H * (0.5 + Math.random() * 0.5));
              }, delay);
            })(m * 140);
          }
          if (!celebrateRAF) celebrateLoop();
        }

        function initCelebrationEasterEgg() {
          var clickCount = 0;
          var celebrateTimer = null;
          document.addEventListener('click', function() {
            clickCount++;
            if (celebrateTimer) clearTimeout(celebrateTimer);
            celebrateTimer = setTimeout(function() { clickCount = 0; }, 2000);
            if (clickCount >= 8) {
              clickCount = 0;
              launchCelebration();
            }
          });
        }

        function updateThemeLabel() {
          var theme = document.documentElement.getAttribute('data-theme') || 'mirror';
          var labels = { mirror: 'Mirror Mode', version: 'Version Mode', loop: 'Loop Mode' };
          var hints = { mirror: '⚡ Neon active', version: '> System ready', loop: '∞ Flowing' };
          document.querySelectorAll('.theme-label-text').forEach(function(el) { el.textContent = '◈ ' + labels[theme]; });
          document.querySelectorAll('.theme-label-hint').forEach(function(el) { el.textContent = hints[theme]; });
          document.querySelectorAll('.footer-theme-label').forEach(function(el) { el.textContent = '● ' + labels[theme]; });
        }

        // =========================================
        // Color Customization Panel
        // =========================================
        function initColorPanel() {
          var panel = document.getElementById('colorPanel');
          var editBtn = document.querySelector('.theme-edit-btn');
          var closeBtn = document.querySelector('.color-panel-close');
          var accent1Input = document.getElementById('colorAccent1');
          var accent2Input = document.getElementById('colorAccent2');
          var hueSlider = document.getElementById('colorHue');
          var hueValue = document.querySelector('.color-hue-value');
          var hueGroup = document.getElementById('hueGroup');
          var resetBtn = document.getElementById('colorResetBtn');

          if (!panel || !editBtn) return;

          function openPanel() {
            var theme = document.documentElement.getAttribute('data-theme');
            var stored = localStorage.getItem('fight1-colors');
            var colors = stored ? JSON.parse(stored) : {};
            var themeColors = colors[theme] || null;

            if (themeColors) {
              if (theme === 'loop') {
                accent1Input.value = hslToHex(themeColors.hue || 270, 80, 68);
                accent2Input.value = hslToHex((themeColors.hue || 270) + 50, 90, 72);
                hueSlider.value = themeColors.hue || 270;
                hueValue.textContent = (themeColors.hue || 270) + '°';
              } else {
                accent1Input.value = themeColors.accent1 || DEFAULT_COLORS[theme].accent1;
                accent2Input.value = themeColors.accent2 || DEFAULT_COLORS[theme].accent2;
              }
            } else {
              if (theme === 'loop') {
                accent1Input.value = hslToHex(DEFAULT_COLORS[theme].hue, 80, 68);
                accent2Input.value = hslToHex(DEFAULT_COLORS[theme].hue + 50, 90, 72);
                hueSlider.value = DEFAULT_COLORS[theme].hue;
                hueValue.textContent = DEFAULT_COLORS[theme].hue + '°';
              } else {
                accent1Input.value = DEFAULT_COLORS[theme].accent1;
                accent2Input.value = DEFAULT_COLORS[theme].accent2;
              }
            }

            hueGroup.style.display = theme === 'loop' ? 'block' : 'none';
            panel.classList.add('open');
            panel.setAttribute('aria-hidden', 'false');
          }

          function closePanel() {
            panel.classList.remove('open');
            panel.setAttribute('aria-hidden', 'true');
          }

          function saveColors() {
            var theme = document.documentElement.getAttribute('data-theme');
            var stored = localStorage.getItem('fight1-colors');
            var colors = stored ? JSON.parse(stored) : {};
            if (theme === 'loop') {
              colors[theme] = { hue: parseInt(hueSlider.value) };
            } else {
              colors[theme] = {
                accent1: accent1Input.value,
                accent2: accent2Input.value,
              };
            }
            localStorage.setItem('fight1-colors', JSON.stringify(colors));
          }

          function updateAccent1Color() {
            var hex = accent1Input.value;
            document.querySelector('.color-hex').textContent = hex;
            document.documentElement.style.setProperty('--accent-1', hex);
            var r = parseInt(hex.slice(1,3), 16);
            var g = parseInt(hex.slice(3,5), 16);
            var b = parseInt(hex.slice(5,7), 16);
            document.documentElement.style.setProperty('--accent-1-dim', 'rgba(' + r + ', ' + g + ', ' + b + ', 0.15)');
            saveColors();
          }

          function updateAccent2Color() {
            var hex = accent2Input.value;
            document.documentElement.style.setProperty('--accent-2', hex);
            var r = parseInt(hex.slice(1,3), 16);
            var g = parseInt(hex.slice(3,5), 16);
            var b = parseInt(hex.slice(5,7), 16);
            document.documentElement.style.setProperty('--accent-2-dim', 'rgba(' + r + ', ' + g + ', ' + b + ', 0.15)');
            saveColors();
          }

          function updateHue() {
            var hue = parseInt(hueSlider.value);
            hueValue.textContent = hue + '°';
            var hue2 = (hue + 50) % 360;
            document.documentElement.style.setProperty('--custom-hue', hue);
            document.documentElement.style.setProperty('--accent-1', 'hsl(' + hue + ', 80%, 68%)');
            document.documentElement.style.setProperty('--accent-2', 'hsl(' + hue2 + ', 90%, 72%)');

            accent1Input.value = hslToHex(hue, 80, 68);
            accent2Input.value = hslToHex(hue2, 90, 72);

            var r1 = Math.round(255 * (0.5 + 0.5 * Math.cos(hue * Math.PI / 180)));
            var g1 = Math.round(255 * (0.5 + 0.5 * Math.cos((hue - 120) * Math.PI / 180)));
            var b1 = Math.round(255 * (0.5 + 0.5 * Math.cos((hue + 120) * Math.PI / 180)));
            document.documentElement.style.setProperty('--accent-1-dim', 'rgba(' + r1 + ', ' + g1 + ', ' + b1 + ', 0.15)');

            var r2 = Math.round(255 * (0.5 + 0.5 * Math.cos(hue2 * Math.PI / 180)));
            var g2 = Math.round(255 * (0.5 + 0.5 * Math.cos((hue2 - 120) * Math.PI / 180)));
            var b2 = Math.round(255 * (0.5 + 0.5 * Math.cos((hue2 + 120) * Math.PI / 180)));
            document.documentElement.style.setProperty('--accent-2-dim', 'rgba(' + r2 + ', ' + g2 + ', ' + b2 + ', 0.15)');

            saveColors();
          }

          function resetColors() {
            var theme = document.documentElement.getAttribute('data-theme');
            var stored = localStorage.getItem('fight1-colors');
            var colors = stored ? JSON.parse(stored) : {};
            delete colors[theme];
            localStorage.setItem('fight1-colors', JSON.stringify(colors));
            applyCustomColors(theme);
            openPanel();
          }

          editBtn.addEventListener('click', openPanel);
          closeBtn.addEventListener('click', closePanel);
          accent1Input.addEventListener('input', updateAccent1Color);
          accent2Input.addEventListener('input', updateAccent2Color);
          hueSlider.addEventListener('input', updateHue);
          resetBtn.addEventListener('click', resetColors);

          document.addEventListener('click', function(e) {
            if (panel.classList.contains('open') &&
                !panel.contains(e.target) &&
                !editBtn.contains(e.target)) {
              closePanel();
            }
          });

          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && panel.classList.contains('open')) {
              closePanel();
            }
          });

          var initTheme = document.documentElement.getAttribute('data-theme');
          applyCustomColors(initTheme);
        }

        function hslToHex(h, s, l) {
          s /= 100;
          l /= 100;
          var a = s * Math.min(l, 1 - l);
          var f = function(n) {
            var k = (n + h / 30) % 12;
            var color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
            return Math.round(255 * color).toString(16).padStart(2, '0');
          };
          return '#' + f(0) + f(8) + f(4);
        }

        // =========================================
        // GitHub Real Data Integration
        // =========================================
        var GITHUB_API = 'https://api.github.com';

        function cacheGet(key) {
          try {
            var item = localStorage.getItem('gh_' + key);
            if (item) {
              var parsed = JSON.parse(item);
              if (Date.now() - parsed.ts < 300000) return parsed.data;
            }
          } catch(e) {}
          return null;
        }

        function cacheSet(key, data) {
          try { localStorage.setItem('gh_' + key, JSON.stringify({ data: data, ts: Date.now() })); } catch(e) {}
        }

        async function ghFetch(url) {
          var cached = cacheGet(url);
          if (cached) return cached;
          try {
            var ctrl = new AbortController();
            var t = setTimeout(function() { ctrl.abort(); }, 8000);
            var resp = await fetch(url, { headers: { Accept: 'application/vnd.github.v3+json' }, signal: ctrl.signal });
            clearTimeout(t);
            if (!resp.ok) return null;
            var data = await resp.json();
            cacheSet(url, data);
            return data;
          } catch(e) { return null; }
        }

        // Record star count for tracking history
        function recordStarCount() {
          try {
            var stored = localStorage.getItem('gh_star_history');
            var history = stored ? JSON.parse(stored) : [];
            var last = history[history.length - 1];
            var now = new Date().toISOString().split('T')[0];
            if (!last || last.date !== now) {
              history.push({ date: now, count: state.totalStars });
              if (history.length > 365) history = history.slice(-365);
              localStorage.setItem('gh_star_history', JSON.stringify(history));
            }
          } catch(e) {}
        }

        // Fetch commits from top repos and build daily contribution map
        async function buildContributionMap(repos) {
          var dayMap = {};
          var top = repos.slice(0, 8);
          var results = await Promise.allSettled(
            top.map(function(repo) {
              return ghFetch(GITHUB_API + '/repos/' + repo.full_name + '/commits?per_page=100');
            })
          );
          for (var i = 0; i < results.length; i++) {
            var commits = results[i].value;
            if (Array.isArray(commits)) {
              for (var j = 0; j < commits.length; j++) {
                var date = commits[j].commit.committer.date.split('T')[0];
                dayMap[date] = (dayMap[date] || 0) + 1;
              }
            }
          }
          return dayMap;
        }

        // Current streak: consecutive days with contributions ending today/yesterday
        function calcStreak(dayMap) {
          var streak = 0;
          var d = new Date();
          // Allow streak to start today or yesterday
          var dStr = d.toISOString().split('T')[0];
          if (!dayMap[dStr]) {
            var yd = new Date(d.getTime() - 86400000);
            if (!dayMap[yd.toISOString().split('T')[0]]) return 0;
            d = yd;
          }
          while (dayMap[d.toISOString().split('T')[0]]) {
            streak++;
            d = new Date(d.getTime() - 86400000);
          }
          return streak;
        }

        async function fetchProfileData() {
          var user, repos;
          try {
            var results = await Promise.allSettled([
              ghFetch(GITHUB_API + '/users/' + USERNAME),
              ghFetch(GITHUB_API + '/users/' + USERNAME + '/repos?type=owner&sort=updated&per_page=30'),
            ]);
            user = results[0].value;
            repos = results[1].value;
          } catch(e) {
            user = null;
            repos = [];
          }

          if (!Array.isArray(repos)) repos = [];
          // Exclude forks, sort by stars
          repos = repos.filter(function(r) { return !r.fork; });
          repos.sort(function(a, b) { return (b.stargazers_count || 0) - (a.stargazers_count || 0); });

          // Update Hero section
          var usernameEl = document.getElementById('hero-username');
          if (usernameEl) usernameEl.textContent = (user && user.login) || USERNAME;

          var avatarEl = document.getElementById('hero-avatar');
          if (avatarEl && user && user.avatar_url) {
            // Request a crisp size; fall back to the offline placeholder if the image 404s.
            var realAvatar = user.avatar_url + (user.avatar_url.indexOf('?') >= 0 ? '&' : '?') + 's=160';
            avatarEl.onerror = function() { avatarEl.src = FALLBACK_AVATAR; avatarEl.onerror = null; };
            avatarEl.src = realAvatar;
            avatarEl.alt = user.login;
            avatarEl.style.display = 'block';
          }

          var bioEl = document.getElementById('hero-bio');
          if (bioEl && user && user.bio) {
            bioEl.textContent = user.bio;
          }

          // Update CTA link
          var ctaEl = document.getElementById('cta-github');
          if (ctaEl && user && user.html_url) {
            ctaEl.href = user.html_url;
          }

          // Update footer username
          var footerEl = document.getElementById('footer-username');
          if (footerEl) footerEl.textContent = (user && user.login) || USERNAME;

          // Compute real stats
          state.totalStars = 0;
          state.langSet = {};
          for (var i = 0; i < repos.length; i++) {
            state.totalStars += repos[i].stargazers_count || 0;
            if (repos[i].language) {
              state.langSet[repos[i].language] = (state.langSet[repos[i].language] || 0) + 1;
            }
          }

          var dayMap = await buildContributionMap(repos);
          var totalCommits = 0;
          var activeDays = 0;
          for (var key in dayMap) {
            totalCommits += dayMap[key];
            activeDays++;
          }
          var streak = calcStreak(dayMap);

          updateStatsSection(user, totalCommits, activeDays, streak);
          updateBattleLog(repos);
          recordStarCount();
        }

        function setText(id, value) {
          var el = document.getElementById(id);
          if (el) el.textContent = value;
        }

        function updateStatsSection(user, totalCommits, activeDays, streak) {
          if (totalCommits > 0) setText('stat-commits', totalCommits.toLocaleString());
          if (activeDays > 0) setText('stat-streak', activeDays + ' days');
          if (user && user.public_repos != null) setText('stat-langs', user.public_repos);
          if (user && user.followers != null) setText('stat-loc', user.followers);
          setText('stat-current-streak', streak > 0 ? streak + ' days' : '—');
          setText('stat-stars', state.totalStars > 0 ? String(state.totalStars) : '—');
        }

        function updateBattleLog(repos) {
          if (!repos || repos.length === 0) return;

          var grid = document.getElementById('projects-grid');
          if (!grid) return;
          grid.innerHTML = '';

          repos.slice(0, 6).forEach(function(repo) {
            var status = getRepoStatus(repo);
            var card = document.createElement('div');
            card.className = 'project-card';

            var statusText = status === 'won' ? '✓ Won' :
                             status === 'learned' ? '⟳ Learned' :
                             status === 'loss' ? '✗ Lost' : '◌ WIP';

            var tagsHtml = '';
            if (repo.topics && repo.topics.length) {
              tagsHtml = repo.topics.slice(0, 3).map(function(t) {
                return '<span class="tag">' + t + '</span>';
              }).join('');
            } else if (repo.language) {
              tagsHtml = '<span class="tag">' + repo.language + '</span>';
            }

            card.innerHTML = '<div class="project-header">' +
              '<div class="project-icon">📁</div>' +
              '<div class="project-status-badge status-' + status + '">' + statusText + '</div>' +
              '</div>' +
              '<h3 class="project-name"><a href="' + repo.html_url + '" target="_blank" rel="noopener">' + repo.name + '</a></h3>' +
              '<p class="project-desc">' + (repo.description || 'No description available.') + '</p>' +
              '<div class="project-tags">' + tagsHtml + '</div>' +
              '<div class="project-footer">' +
              '<span class="project-stars">⭐ ' + (repo.stargazers_count || 0) + '</span>' +
              '<span class="project-updated">Updated ' + formatDate(repo.pushed_at) + '</span>' +
              '</div>';

            grid.appendChild(card);
          });
        }

        function getRepoStatus(repo) {
          if (repo.stargazers_count > 20) return 'won';
          if (repo.open_issues_count > repo.stargazers_count) return 'loss';
          if (repo.stargazers_count > 0) return 'learned';
          return 'wip';
        }

        function formatDate(dateStr) {
          var d = new Date(dateStr);
          var now = new Date();
          var diff = Math.floor((now.getTime() - d.getTime()) / (1000 * 60 * 60 * 24));
          if (diff === 0) return 'Just now';
          if (diff === 1) return 'Yesterday';
          if (diff < 30) return diff + ' days ago';
          if (diff < 365) return Math.floor(diff / 30) + ' months ago';
          return d.toLocaleDateString('en', { month: 'short', year: 'numeric' });
        }

        var state = {
          user: null,
          repos: [],
          totalStars: 0,
          langSet: {},
          repoCount: 0,
        };

        // =========================================
        // Init
        // =========================================
        setInitialState();
        applyTheme(THEMES[currentIndex]);
        startAutoSwitch();
        setupManualControls();
        setupIdleDetection();
        initCelebrationEasterEgg();
        initColorPanel();
        updateThemeLabel();

        // Show the offline fallback avatar immediately so it's never blank;
        // fetchProfileData() upgrades it to the real GitHub avatar when available.
        var heroAvatarEl = document.getElementById('hero-avatar');
        if (heroAvatarEl) {
          heroAvatarEl.src = FALLBACK_AVATAR;
          heroAvatarEl.alt = USERNAME;
          heroAvatarEl.style.display = 'block';
        }

        // Fetch real GitHub data
        fetchProfileData();

        // =========================================
        // Scroll Animations
        // =========================================
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var bars = entry.target.querySelectorAll('[data-width]');
              bars.forEach(function(bar, i) {
                setTimeout(function() { bar.style.width = bar.dataset.width + '%'; }, i * 80);
              });
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });

        document.querySelectorAll('.skills-grid').forEach(function(grid) { observer.observe(grid); });

        var fadeObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.style.animation = 'fadeInUp 0.6s var(--ease-spring) both';
              fadeObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.section-fade-in').forEach(function(el) {
          el.style.opacity = '0';
          fadeObserver.observe(el);
        });

        window.addEventListener('themeChanged', function() {
          updateThemeLabel();
        });

        // =========================================
        // Cursor Glow
        // =========================================
        var glow = document.querySelector('.cursor-glow');
        if (glow && window.matchMedia('(pointer: fine)').matches) {
          document.addEventListener('mousemove', function(e) {
            glow.style.left = e.clientX + 'px';
            glow.style.top = e.clientY + 'px';
          });
        }
      })();
    </script>
  </body>
</html>