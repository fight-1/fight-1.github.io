        // ---- Feature 7: Three NPC personas ----
        var NPC_LINES = {
          mirror: [
            '镜灵：你这周只推了 {commits} 次，镜子可不撒谎。',
            '镜灵：真实数据不会骗人——你离"完美版本"还差得远。',
            '镜灵：照照看，今天的你比昨天强了吗？'
          ],
          version: [
            '史官：从 {repos} 个仓库看，你的版本号在稳步攀升。',
            '史官：累计 {stars} 颗星，成长曲线向上，保持。',
            '史官：新技能树已记录，下一版会更猛。'
          ],
          loop: [
            '狂战士：今天 {today} 次提交，还在循环里——推了吗？没推就是摸鱼！',
            '狂战士：连击 {streak} 天，别断！断了就重开。',
            '狂战士：Flow 状态在线，继续冲！'
          ]
        };
        function npcLine(theme) {
          var arr = NPC_LINES[theme] || NPC_LINES.mirror;
          var t = arr[Math.floor(Math.random() * arr.length)];
          var todayStr = new Date().toISOString().split('T')[0];
          var today = (state.dayMap && state.dayMap[todayStr]) || 0;
          return t
            .replace('{commits}', state.totalCommits || 0)
            .replace('{repos}', (state.repos && state.repos.length) || 0)
            .replace('{stars}', state.totalStars || 0)
            .replace('{streak}', state.streak || 0)
            .replace('{today}', today);
        }
        function initNpcPersonas() {
          var avatar = document.getElementById('hero-avatar');
          var bubble = document.getElementById('npc-bubble');
          function speak(theme) {
            if (!bubble) return;
            bubble.textContent = npcLine(theme);
            bubble.classList.add('show');
            clearTimeout(bubble._t);
            bubble._t = setTimeout(function() { bubble.classList.remove('show'); }, 4000);
          }
          if (avatar) avatar.addEventListener('click', function(e) {
            e.stopPropagation();
            speak(document.documentElement.getAttribute('data-theme') || 'mirror');
          });
        }

        // ---- Feature 3: State Lens (three real-data views) ----
        function initStateLens() {
          var tabs = document.querySelectorAll('.state-lens-tab');
          tabs.forEach(function(btn) { btn.addEventListener('click', function() { showLens(btn.dataset.lens); }); });
          window.addEventListener('themeChanged', function(e) {
            var th = (e.detail && e.detail.theme) || document.documentElement.getAttribute('data-theme');
            showLens(th);
          });
          function showLens(theme) {
            tabs.forEach(function(b) { b.classList.toggle('active', b.dataset.lens === theme); });
            ['mirror', 'version', 'loop'].forEach(function(t) {
              var p = document.getElementById('lens-' + t);
              if (p) p.hidden = (t !== theme);
            });
          }
          window.addEventListener('ghDataReady', function() { renderLens(); });
          renderLens();
          fetchEventsForLens();
        }
        function renderLens() {
          renderMirrorLens();
          renderVersionLens();
          renderLoopLens();
        }
        function renderMirrorLens() {
          var heat = document.getElementById('lens-heatmap');
          if (heat) {
            var days = [];
            var today = new Date();
            for (var i = 118; i >= 0; i--) { var d = new Date(today.getTime() - i * 86400000); days.push(d.toISOString().split('T')[0]); }
            var max = 1;
            days.forEach(function(k) { var v = (state.dayMap && state.dayMap[k]) || 0; if (v > max) max = v; });
            var html = '';
            days.forEach(function(k) {
              var v = (state.dayMap && state.dayMap[k]) || 0;
              var lvl = v === 0 ? 0 : Math.ceil(v / max * 4);
              html += '<div class="hm-cell hm-' + lvl + '" title="' + k + ': ' + v + ' commits"></div>';
            });
            heat.innerHTML = html;
          }
          var langEl = document.getElementById('lens-langs');
          if (langEl) {
            var langs = state.langSet || {};
            var entries = Object.keys(langs).map(function(k) { return [k, langs[k]]; }).sort(function(a, b) { return b[1] - a[1]; });
            if (entries.length) {
              var maxL = entries[0][1];
              langEl.innerHTML = entries.slice(0, 8).map(function(e) {
                var pct = Math.round(e[1] / maxL * 100);
                return '<div class="lang-row"><span class="lang-name">' + e[0] + '</span><div class="lang-bar"><div class="lang-fill" style="width:' + pct + '%"></div></div><span class="lang-val">' + e[1] + '</span></div>';
              }).join('');
            } else {
              langEl.innerHTML = '<p class="lens-empty">数据加载中…（需要网络访问 GitHub API）</p>';
            }
          }
        }
        function renderVersionLens() {
          var el = document.getElementById('lens-growth');
          if (!el) return;
          var repos = state.repos || [];
          if (!repos.length) { el.innerHTML = '<p class="lens-empty">数据加载中…</p>'; return; }
          var byMonth = {};
          repos.forEach(function(r) { var m = (r.created_at || '').slice(0, 7); if (m) byMonth[m] = (byMonth[m] || 0) + 1; });
          var months = Object.keys(byMonth).sort();
          var cum = 0; var pts = [];
          months.forEach(function(m) { cum += byMonth[m]; pts.push(cum); });
          var maxV = cum || 1; var w = 100, h = 60;
          var path = pts.map(function(v, i) {
            var x = months.length > 1 ? (i / (months.length - 1)) * w : 0;
            var y = h - (v / maxV) * h;
            return (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1);
          }).join(' ');
          el.innerHTML = '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" class="growth-svg"><path d="' + path + '" fill="none" stroke="' + getAccent() + '" stroke-width="1.5"/></svg>' +
            '<p class="lens-note">从 ' + months[0] + ' 到 ' + months[months.length - 1] + ' · 累计 ' + cum + ' 个仓库</p>';
        }
        function renderLoopLens() {
          var el = document.getElementById('lens-activity');
          if (!el) return;
          if (state._events && state._events.length) {
            el.innerHTML = state._events.slice(0, 12).map(function(ev) {
              var act = (ev.type || '').replace('Event', '');
              var repo = ev.repo ? ev.repo.name : '';
              var when = formatDate(ev.created_at);
              return '<div class="act-row"><span class="act-type">' + act + '</span><span class="act-repo">' + repo + '</span><span class="act-when">' + when + '</span></div>';
            }).join('');
          } else {
            el.innerHTML = '<p class="lens-empty">活动流加载中…（将从 GitHub events API 拉取）</p>';
          }
        }
        function fetchEventsForLens() {
          ghFetch(GITHUB_API + '/users/' + USERNAME + '/events/public').then(function(events) {
            if (Array.isArray(events)) { state._events = events; renderLoopLens(); }
          });
        }

        // ---- Feature 2: Release timeline + real Patch Notes ----
        function initReleaseTimeline() {
          var input = document.getElementById('repo-input');
          var btn = document.getElementById('repo-load');
          var timeline = document.getElementById('release-timeline');
          function load(repo) {
            if (timeline) timeline.innerHTML = '<p class="lens-empty">加载中…</p>';
            ghFetch(GITHUB_API + '/repos/' + repo + '/releases?per_page=12').then(function(rels) {
              if (!Array.isArray(rels) || !rels.length) {
                if (timeline) timeline.innerHTML = '<p class="lens-empty">该仓库暂无 Release，保留写死的 Patch Notes。</p>';
                return;
              }
              if (timeline) {
                timeline.innerHTML = rels.map(function(r, i) {
                  var date = (r.published_at || '').slice(0, 10);
                  var body = (r.body || '(无说明)').replace(/</g, '&lt;').slice(0, 400);
                  return '<div class="tl-item' + (i === 0 ? ' tl-latest' : '') + '"><div class="tl-dot"></div><div class="tl-card"><div class="tl-head"><span class="tl-ver">' + (r.tag_name || r.name || 'v?') + '</span><span class="tl-date">' + date + '</span></div><div class="tl-body">' + body + '</div></div></div>';
                }).join('');
              }
              var cl = document.getElementById('changelog');
              if (cl) {
                cl.innerHTML = rels.slice(0, 4).map(function(r) {
                  var date = (r.published_at || '').slice(0, 7);
                  var lines = (r.body || '').split('\n').filter(function(l) { return l.trim(); }).slice(0, 5).map(function(l) {
                    return '<li class="changelog-item"><span class="change-badge change-add">●</span><span>' + l.replace(/</g, '&lt;').slice(0, 120) + '</span></li>';
                  }).join('');
                  return '<div class="changelog-entry"><div class="changelog-header"><span class="changelog-version">' + (r.tag_name || r.name) + '</span><span class="changelog-date">' + date + '</span></div><ul class="changelog-list">' + (lines || '<li class="changelog-item"><span>无说明</span></li>') + '</ul></div>';
                }).join('');
              }
            });
          }
          if (btn) btn.addEventListener('click', function() { if (input && input.value) load(input.value.trim()); });
          if (input && input.value) load(input.value.trim());
        }

        // ---- Feature 9: Achievements (bound to real events) ----
        var ACHIEVEMENTS = [
          { id: 'first_pr', name: '初代 PR', icon: '🔀', desc: '合并第一个 Pull Request' },
          { id: 'big_day', name: '爆发日', icon: '💥', desc: '单日 10+ commit' },
          { id: 'centurion', name: '百星', icon: '⭐', desc: '累计 100 star' },
          { id: 'streak30', name: '30 天连击', icon: '🔥', desc: '连续 30 天 push' },
          { id: 'first_issue', name: '首杀 Issue', icon: '🐛', desc: '关闭第一个 issue' }
        ];
        function initAchievements() {
          var wall = document.getElementById('badge-wall');
          if (!wall) return;
          function render(unlocked) {
            wall.innerHTML = ACHIEVEMENTS.map(function(a) {
              var on = unlocked[a.id];
              return '<div class="badge' + (on ? ' badge-on' : '') + '" title="' + a.desc + '"><div class="badge-icon">' + a.icon + '</div><div class="badge-name">' + a.name + '</div><div class="badge-desc">' + a.desc + '</div></div>';
            }).join('');
          }
          render({});
          ghFetch(GITHUB_API + '/users/' + USERNAME + '/events/public').then(function(events) {
            var unlocked = {};
            if (Array.isArray(events)) {
              state._events = state._events || events;
              var dayCommits = {};
              events.forEach(function(ev) {
                if (ev.type === 'PullRequestEvent' && ev.payload && ev.payload.action === 'closed' && ev.payload.pull_request && ev.payload.pull_request.merged) unlocked.first_pr = true;
                if (ev.type === 'IssuesEvent' && ev.payload && ev.payload.action === 'closed') unlocked.first_issue = true;
                if (ev.type === 'PushEvent' && ev.payload && ev.payload.commits) {
                  var d = (ev.created_at || '').slice(0, 10);
                  dayCommits[d] = (dayCommits[d] || 0) + (ev.payload.commits.length || 0);
                }
              });
              Object.keys(dayCommits).forEach(function(d) { if (dayCommits[d] >= 10) unlocked.big_day = true; });
            }
            if (state.totalStars >= 100) unlocked.centurion = true;
            if (state.streak >= 30) unlocked.streak30 = true;
            render(unlocked);
            Object.keys(unlocked).forEach(function(id) {
              if (!localStorage.getItem('gh_ach_' + id)) {
                try { localStorage.setItem('gh_ach_' + id, '1'); } catch (e) {}
                var a = ACHIEVEMENTS.filter(function(x) { return x.id === id; })[0];
                if (a) showToast('🏆 成就解锁：' + a.name);
              }
            });
          });
        }
        function showToast(msg) {
          var t = document.createElement('div');
          t.className = 'fight-toast';
          t.textContent = msg;
          document.body.appendChild(t);
          setTimeout(function() { t.classList.add('show'); }, 50);
          setTimeout(function() { t.classList.remove('show'); setTimeout(function() { t.remove(); }, 400); }, 3500);
        }

        // ---- Feature 5: Dynamic share card (Canvas OG image) ----
        function initShareCard() {
          var btn = document.getElementById('btn-share');
          var modal = document.getElementById('share-modal');
          var canvas = document.getElementById('share-canvas');
          var dl = document.getElementById('share-download');
          var close = document.getElementById('share-close');
          if (!btn || !modal) return;
          function openM() { modal.classList.add('open'); drawShareCard(canvas); }
          function closeM() { modal.classList.remove('open'); }
          btn.addEventListener('click', function(e) { e.preventDefault(); openM(); });
          if (close) close.addEventListener('click', closeM);
          modal.addEventListener('click', function(e) { if (e.target === modal) closeM(); });
          if (dl) dl.addEventListener('click', function() {
            var link = document.createElement('a');
            link.download = 'fight-1-share.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
          });
        }
        function drawShareCard(canvas) {
          if (!canvas) return;
          var ctx = canvas.getContext('2d');
          var W = 600, H = 315;
          canvas.width = W; canvas.height = H;
          ctx.fillStyle = '#0b0b0f'; ctx.fillRect(0, 0, W, H);
          ctx.strokeStyle = getAccent(); ctx.lineWidth = 4; ctx.strokeRect(8, 8, W - 16, H - 16);
          function finish() {
            ctx.fillStyle = '#ffffff'; ctx.font = 'bold 34px Inter, Arial, sans-serif';
            ctx.fillText((state.user && state.user.login) || USERNAME, 150, 120);
            ctx.fillStyle = getAccent(); ctx.font = '600 16px Inter, Arial, sans-serif';
            ctx.fillText('Tri-State Self · Me against Me', 150, 150);
            ctx.fillStyle = '#cbd5e1'; ctx.font = '15px Inter, Arial, sans-serif';
            ctx.fillText('本周贡献 ' + ((state.dayMap && Object.keys(state.dayMap).length) || 0) + ' 天 · ⭐ ' + (state.totalStars || 0) + ' · 🔥 ' + (state.streak || 0) + ' 天连击', 150, 185);
            ctx.fillStyle = '#94a3b8'; ctx.font = '13px JetBrains Mono, monospace';
            ctx.fillText('fight-1.github.io', 150, 215);
            try {
              var og = document.querySelector('meta[property="og:image"]');
              if (!og) { og = document.createElement('meta'); og.setAttribute('property', 'og:image'); document.head.appendChild(og); }
              og.setAttribute('content', canvas.toDataURL('image/png'));
            } catch (e) {}
          }
          var img = document.getElementById('hero-avatar');
          if (img && img.src && img.src.indexOf('data:') !== 0) {
            var a = new Image();
            a.crossOrigin = 'anonymous';
            a.onload = function() { try { ctx.save(); ctx.beginPath(); ctx.arc(70, 110, 40, 0, Math.PI * 2); ctx.clip(); ctx.drawImage(a, 30, 70, 80, 80); ctx.restore(); } catch (e) {} finish(); };
            a.onerror = finish;
            a.src = img.src;
          } else { finish(); }
        }

        // ---- Feature 6: Save file export ----
        function initSaveFile() {
          var btn = document.getElementById('btn-save');
          if (!btn) return;
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var snapshot = {
              username: (state.user && state.user.login) || USERNAME,
              savedAt: new Date().toISOString(),
              totalStars: state.totalStars,
              totalCommits: state.totalCommits,
              activeDays: state.activeDays,
              streak: state.streak,
              publicRepos: state.user ? state.user.public_repos : null,
              followers: state.user ? state.user.followers : null,
              languages: state.langSet,
              repos: (state.repos || []).slice(0, 30).map(function(r) { return { name: r.name, stars: r.stargazers_count, lang: r.language, pushed: r.pushed_at }; }),
              achievements: ACHIEVEMENTS.map(function(a) { return a.id; })
            };
            var blob = new Blob([JSON.stringify(snapshot, null, 2)], { type: 'application/json' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = 'fight-1.save.json'; a.click();
            URL.revokeObjectURL(url);
            showToast('💾 已导出 fight-1.save.json');
          });
        }

        // =========================================
        // Init
        // =========================================
        setInitialState();
        applyTheme(THEMES[currentIndex]);
        startAutoSwitch();
        setupManualControls();
        setupIdleDetection();
        initCelebrationEasterEgg();
        initColorPanel();
        updateThemeLabel();

        // New features (2026-09-07)
        initMouseTrail();
        initHeroGlitch();
        initChallengerCounter();
        initNpcPersonas();
        initStateLens();
        initReleaseTimeline();
        initShareCard();
        initSaveFile();
        initAchievements();
        initPaletteSystem();

        // Show the offline fallback avatar immediately so it's never blank;
        // fetchProfileData() upgrades it to the real GitHub avatar when available.
        var heroAvatarEl = document.getElementById('hero-avatar');
        if (heroAvatarEl) {
          heroAvatarEl.src = FALLBACK_AVATAR;
          heroAvatarEl.alt = USERNAME;
          heroAvatarEl.style.display = 'block';
        }

        // Fetch real GitHub data
        fetchProfileData();

        // =========================================
        // Scroll Animations
        // =========================================
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var bars = entry.target.querySelectorAll('[data-width]');
              bars.forEach(function(bar, i) {
                setTimeout(function() { bar.style.width = bar.dataset.width + '%'; }, i * 80);
              });
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });

        document.querySelectorAll('.skills-grid').forEach(function(grid) { observer.observe(grid); });

        var fadeObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.style.animation = 'fadeInUp 0.6s var(--ease-spring) both';
              fadeObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.section-fade-in').forEach(function(el) {
          el.style.opacity = '0';
          fadeObserver.observe(el);
        });

        window.addEventListener('themeChanged', function() {
          updateThemeLabel();
        });

        // =========================================
        // Cursor Glow
        // =========================================
        var glow = document.querySelector('.cursor-glow');
        if (glow && window.matchMedia('(pointer: fine)').matches) {
          document.addEventListener('mousemove', function(e) {
            glow.style.left = e.clientX + 'px';
            glow.style.top = e.clientY + 'px';
          });
        }
      })();
    </script>
  </body>
</html>