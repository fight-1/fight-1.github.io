---
// Theme Indicator — Floating theme switcher dots
// Completely different visual language per theme
// Includes color customization panel
---

<div class="theme-indicator" aria-label="Theme selector">
  <button
    class="theme-dot"
    data-theme="mirror"
    title="Mirror Mode — Cyberpunk"
  >
    <span class="dot-visual" style="background: var(--accent-1, #00f3ff);"></span>
  </button>
  <button
    class="theme-dot"
    data-theme="version"
    title="Version Mode — Terminal"
  >
    <span class="dot-visual" style="background: var(--accent-1, #00ff88);"></span>
  </button>
  <button
    class="theme-dot"
    data-theme="loop"
    title="Loop Mode — Fluid"
  >
    <span class="dot-visual" style="background: hsl(var(--custom-hue, 270), 80%, 68%);"></span>
  </button>

  <button
    class="theme-edit-btn"
    title="Customize colors"
    aria-label="Open color customization panel"
  >
    <svg class="edit-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </svg>
  </button>
</div>

<!-- Color Customization Panel -->
<div class="color-panel" id="colorPanel" aria-hidden="true">
  <div class="color-panel-header">
    <span class="color-panel-title">🎨 Customize Colors</span>
    <button class="color-panel-close" aria-label="Close panel">✕</button>
  </div>

  <div class="color-group">
    <label class="color-label" for="colorAccent1">Accent 1</label>
    <div class="color-picker-row">
      <input type="color" id="colorAccent1" value="#00f3ff" class="color-input">
      <span class="color-hex">#00f3ff</span>
    </div>
  </div>

  <div class="color-group">
    <label class="color-label" for="colorAccent2">Accent 2</label>
    <div class="color-picker-row">
      <input type="color" id="colorAccent2" value="#ff00ff" class="color-input">
      <span class="color-hex">#ff00ff</span>
    </div>
  </div>

  <div class="color-group color-group-loop" id="hueGroup" style="display: none;">
    <label class="color-label" for="colorHue">Hue Base</label>
    <div class="color-picker-row">
      <input type="range" id="colorHue" min="0" max="360" value="270" class="color-slider">
      <span class="color-hue-value">270°</span>
    </div>
  </div>

  <button class="color-reset-btn" id="colorResetBtn">↺ Reset to Default</button>
</div>

<style>
  .theme-indicator {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem;
    transition: all var(--duration-normal) var(--ease-spring);
    opacity: 0.85;
  }

  .theme-indicator:hover {
    opacity: 1;
    transform: translateX(-2px);
  }

  .theme-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-dot:hover {
    transform: scale(1.3);
  }

  .theme-dot:active {
    transform: scale(0.9);
  }

  .dot-visual {
    width: 8px;
    height: 8px;
    transition: all 0.3s ease;
  }

  .theme-edit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border: none;
    background: transparent;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.2s, transform 0.2s;
    padding: 0;
  }

  .theme-edit-btn:hover {
    opacity: 0.8;
    transform: scale(1.2);
  }

  .theme-edit-btn:active {
    transform: scale(0.9);
  }

  .edit-icon {
    stroke: currentColor;
  }

  /* ==========================================
     🪞 Mirror — Angular, neon, aggressive
     ========================================== */
  [data-theme="mirror"] .theme-indicator {
    box-shadow: -4px 0 20px rgba(0, 243, 255, 0.15);
    background: rgba(0, 243, 255, 0.02);
    border: 1px solid rgba(0, 243, 255, 0.1);
    clip-path: polygon(0 8px, 8px 8px, 8px 0, calc(100% - 8px) 0, calc(100% - 8px) 8px, 100% 8px, 100% calc(100% - 8px), calc(100% - 8px) calc(100% - 8px), calc(100% - 8px) 100%, 8px 100%, 8px calc(100% - 8px), 0 calc(100% - 8px));
  }

  [data-theme="mirror"] .dot-visual {
    transform: rotate(45deg);
    box-shadow: 0 0 8px var(--accent-1, #00f3ff);
  }

  [data-theme="mirror"] .theme-dot.active .dot-visual {
    width: 12px;
    height: 12px;
    box-shadow: 0 0 15px var(--accent-1, #00f3ff), 0 0 30px rgba(0, 243, 255, 0.3);
  }

  [data-theme="mirror"] .theme-dot.active::before {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px solid var(--accent-1, #00f3ff);
    opacity: 0.4;
    animation: glitch-ring 1.5s ease-in-out infinite;
  }

  @keyframes glitch-ring {
    0%, 100% { transform: scale(1); opacity: 0.4; clip-path: polygon(0 3px, 3px 3px, 3px 0, calc(100% - 3px) 0, calc(100% - 3px) 3px, 100% 3px, 100% calc(100% - 3px), calc(100% - 3px) calc(100% - 3px), calc(100% - 3px) 100%, 3px 100%, 3px calc(100% - 3px), 0 calc(100% - 3px)); }
    25% { transform: scale(1.1); opacity: 0.6; }
    50% { transform: scale(1); opacity: 0.3; clip-path: none; }
    75% { transform: scale(1.05) translateX(1px); opacity: 0.5; }
  }

  /* ==========================================
     📝 Version — Minimal, square, blinking
     ========================================== */
  [data-theme="version"] .theme-indicator {
    background: transparent;
    border: 1px solid rgba(0, 255, 136, 0.1);
    border-radius: 0px;
  }

  [data-theme="version"] .theme-indicator:hover {
    transform: none;
    background: rgba(0, 255, 136, 0.03);
  }

  [data-theme="version"] .dot-visual {
    border-radius: 0px;
    width: 6px;
    height: 6px;
  }

  [data-theme="version"] .theme-dot.active .dot-visual {
    width: 10px;
    height: 10px;
    box-shadow: none;
  }

  [data-theme="version"] .theme-dot.active::before {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px dashed var(--accent-1, #00ff88);
    opacity: 0.5;
    animation: none;
  }

  /* ==========================================
     ♾️ Loop — Rounded, soft, breathing
     ========================================== */
  [data-theme="loop"] .theme-indicator {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: 999px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  [data-theme="loop"] .theme-indicator:hover {
    transform: translateX(-2px) scale(1.02);
  }

  [data-theme="loop"] .dot-visual {
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  [data-theme="loop"] .theme-dot.active .dot-visual {
    width: 12px;
    height: 12px;
    box-shadow: 0 0 12px hsla(var(--custom-hue, 270), 80%, 60%, 0.5);
  }

  [data-theme="loop"] .theme-dot.active::before {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.3;
    animation: loop-pulse-ring 3s ease-in-out infinite;
  }

  @keyframes loop-pulse-ring {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.5); opacity: 0; }
  }

  /* ==========================================
     Color Panel — Universal Styles
     ========================================== */
  .color-panel {
    position: fixed;
    bottom: 5rem;
    right: 1.5rem;
    z-index: 999;
    width: 260px;
    padding: 1.25rem;
    border-radius: 16px;
    background: var(--bg-surface);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    opacity: 0;
    transform: translateY(8px) scale(0.95);
    pointer-events: none;
    transition: all 0.3s var(--ease-spring);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .color-panel.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .color-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .color-panel-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .color-panel-close {
    width: 20px;
    height: 20px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .color-panel-close:hover {
    background: rgba(255,255,255,0.06);
    color: var(--text-primary);
  }

  .color-group {
    margin-bottom: 0.75rem;
  }

  .color-group-loop {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(255,255,255,0.06);
  }

  .color-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .color-picker-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .color-input {
    width: 36px;
    height: 28px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
    padding: 2px;
    flex-shrink: 0;
  }

  .color-input::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .color-input::-webkit-color-swatch {
    border: none;
    border-radius: 4px;
  }

  .color-hex {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .color-slider {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    border-radius: 3px;
    background: linear-gradient(to right,
      hsl(0, 80%, 60%), hsl(60, 80%, 60%), hsl(120, 80%, 60%),
      hsl(180, 80%, 60%), hsl(240, 80%, 60%), hsl(300, 80%, 60%), hsl(360, 80%, 60%)
    );
    outline: none;
    cursor: pointer;
  }

  .color-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--accent-1);
    box-shadow: 0 0 6px rgba(0,0,0,0.3);
    cursor: pointer;
  }

  .color-slider::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--accent-1);
    box-shadow: 0 0 6px rgba(0,0,0,0.3);
    cursor: pointer;
  }

  .color-hue-value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  .color-reset-btn {
    width: 100%;
    padding: 0.5rem;
    margin-top: 0.5rem;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .color-reset-btn:hover {
    border-color: var(--accent-1);
    color: var(--accent-1);
    background: var(--accent-1-dim);
  }
</style>