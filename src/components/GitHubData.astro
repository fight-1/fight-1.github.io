---
// =========================================
// GitHubData.astro — SPA Component
// Fetches and renders real GitHub data
// Theme-specific chart rendering
// =========================================

// CSS is embedded as a template string and injected via client script
// to avoid Astro component compilation issues with client:load
---

<div class="github-data-container">
  <div class="github-loading" id="gh-loading">
    <div class="spinner"></div>
    Fetching real data from GitHub...
  </div>
</div>

<script client:load>
(function() {
  var USERNAME = 'fight-1';

  // Inject styles — theme-specific rendering
  var css = [
    '.github-data-container{width:100%;position:relative}',
    '.github-loading{text-align:center;padding:3rem;color:var(--text-muted);font-family:var(--font-mono);font-size:0.85rem}',
    '.github-loading .spinner{width:32px;height:32px;border:2px solid var(--bg-elevated);border-top-color:var(--accent-1);border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 1rem}',
    '@keyframes spin{to{transform:rotate(360deg)}}',
    '.github-error{text-align:center;padding:2rem;color:var(--text-muted);font-size:0.85rem;border:1px solid rgba(255,255,255,0.06);border-radius:var(--border-radius-md);background:var(--bg-card)}',
    '.github-data-section{padding:2rem 0}',
    '.data-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(350px,1fr));gap:1.5rem;margin-top:1.5rem}',
    '.data-card{background:var(--bg-card);border:1px solid rgba(255,255,255,0.06);border-radius:var(--border-radius-md);padding:1.5rem;transition:all var(--duration-normal) var(--ease-spring)}',
    '.data-card:hover{border-color:rgba(255,255,255,0.12)}',
    '.data-card h3{font-size:0.95rem;margin-bottom:1rem;color:var(--text-primary);display:flex;align-items:center;gap:0.5rem}',
    '.stats-row{display:flex;justify-content:space-around;text-align:center;flex-wrap:wrap;gap:1rem}',
    '.stat-item-value{font-size:1.5rem;font-weight:700;color:var(--accent-1);font-family:var(--font-mono)}',
    '.stat-item-label{font-size:0.75rem;color:var(--text-secondary);margin-top:0.25rem}',
    '.contrib-chart,.star-chart{overflow-x:auto;padding:0.5rem 0}',
    '.contrib-chart svg,.star-chart svg{min-width:100%}',
    '.language-chart{display:flex;justify-content:center;overflow-x:auto;padding:0.5rem 0}',
    '.language-chart svg{max-width:100%}',
    '@media(max-width:768px){.data-grid{grid-template-columns:fr}}',
  ].join('\n');

  var styleEl = document.createElement('style');
  styleEl.textContent = css;
  document.head.appendChild(styleEl);

  var container = document.querySelector('.github-data-container');
  if (!container) return;

  // Cache of last rendered real data (for theme-change re-renders)
  var lastContributions = null;
  var lastStarHistory = null;

  // ---- Theme-aware rendering ----

  function getThemeColors(theme) {
    var colors = {
      mirror: { primary: '#00f3ff', secondary: '#ff00ff', bg: '#0d1117' },
      version: { primary: '#00ff88', secondary: '#ffaa00', bg: '#0a0e0a' },
      loop: { primary: '#b478ff', secondary: '#78b4ff', bg: '#0d0a14' },
    };
    return colors[theme] || colors.mirror;
  }

  function getContribLevels(theme) {
    var c = getThemeColors(theme);
    return [c.bg, c.primary + '22', c.primary + '55', c.primary + '88', c.primary];
  }

  function renderContribHeatmap(container, days, theme) {
    var levels = getContribLevels(theme);
    var cfg = themes[theme] || themes.mirror;
    var cols = 52;
    var total = days.length;
    var rows = 7;

    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('width', cols * 15);
    svg.setAttribute('height', rows * 15 + 20);

    for (var col = 0; col < cols && col * rows < total; col++) {
      for (var row = 0; row < rows; row++) {
        var idx = col * rows + row;
        if (idx >= total) continue;
        var day = days[idx];
        var rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', String(col * 15));
        rect.setAttribute('y', String(row * 15 + 10));

        // Theme-specific cell shapes
        if (theme === 'mirror') {
          // Sharp squares
          rect.setAttribute('width', '13');
          rect.setAttribute('height', '13');
          rect.setAttribute('rx', '0');
        } else if (theme === 'version') {
          // Small dots
          rect.setAttribute('width', '10');
          rect.setAttribute('height', '10');
          rect.setAttribute('x', String(col * 15 + 2));
          rect.setAttribute('y', String(row * 15 + 12));
          rect.setAttribute('rx', '0');
        } else {
          // Rounded circles
          rect.setAttribute('width', '13');
          rect.setAttribute('height', '13');
          rect.setAttribute('rx', '6');
        }

        rect.setAttribute('fill', levels[day.level]);
        if (day.date) {
          rect.setAttribute('data-date', day.date);
          rect.setAttribute('data-count', String(day.count));
          rect.title = day.date + ': ' + day.count + ' contributions';
        }
        svg.appendChild(rect);
      }
    }

    container.innerHTML = '';
    container.appendChild(svg);
  }

  function renderLanguagePie(container, languages, theme) {
    var total = 0;
    for (var i = 0; i < languages.length; i++) total += languages[i].bytes;
    if (total === 0) { container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">No data yet</p>'; return; }

    var size = 200;
    var cx = size / 2, cy = size / 2;
    var r = 80, innerR = 50;
    var topLangs = languages.slice(0, 8);

    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('width', String(size));
    svg.setAttribute('height', String(size + 60));

    var startAngle = 0;
    for (var i = 0; i < topLangs.length; i++) {
      var lang = topLangs[i];
      var angle = (lang.bytes / total) * 360;
      var endAngle = startAngle + angle;

      var outerStart = ((startAngle - 90) * Math.PI) / 180;
      var outerEnd = ((endAngle - 90) * Math.PI) / 180;
      var largeArc = angle > 180 ? 1 : 0;

      var x1 = cx + r * Math.cos(outerStart);
      var y1 = cy + r * Math.sin(outerStart);
      var x2 = cx + r * Math.cos(outerEnd);
      var y2 = cy + r * Math.sin(outerEnd);
      var ix1 = cx + innerR * Math.cos(outerStart);
      var iy1 = cy + innerR * Math.sin(outerStart);
      var ix2 = cx + innerR * Math.cos(outerEnd);
      var iy2 = cy + innerR * Math.sin(outerEnd);

      var d = 'M ' + x1 + ' ' + y1 + ' A ' + r + ' ' + r + ' 0 ' + largeArc + ' 1 ' + x2 + ' ' + y2 + ' L ' + ix2 + ' ' + iy2 + ' A ' + innerR + ' ' + innerR + ' 0 ' + largeArc + ' 0 ' + ix1 + ' ' + iy1 + ' Z';
      var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', d);
      path.setAttribute('fill', lang.color);

      if (theme === 'mirror') {
        path.setAttribute('opacity', '0.9');
        path.setAttribute('stroke', 'rgba(0,0,0,0.3)');
        path.setAttribute('stroke-width', '1');
      } else if (theme === 'version') {
        path.setAttribute('opacity', '0.7');
        path.setAttribute('stroke', 'rgba(0,255,136,0.2)');
        path.setAttribute('stroke-width', '0.5');
      } else {
        path.setAttribute('opacity', '0.85');
      }

      svg.appendChild(path);
      startAngle = endAngle;
    }

    var t1 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    t1.setAttribute('x', String(cx));
    t1.setAttribute('y', String(cy - 4));
    t1.setAttribute('text-anchor', 'middle');
    t1.setAttribute('fill', 'var(--text-primary)');
    t1.setAttribute('font-size', '14');
    t1.setAttribute('font-weight', '600');
    t1.textContent = String(languages.length);
    svg.appendChild(t1);

    var t2 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    t2.setAttribute('x', String(cx));
    t2.setAttribute('y', String(cy + 12));
    t2.setAttribute('text-anchor', 'middle');
    t2.setAttribute('fill', 'var(--text-secondary)');
    t2.setAttribute('font-size', '9');
    t2.setAttribute('font-family', 'var(--font-mono)');
    t2.textContent = 'languages';
    svg.appendChild(t2);

    // Legend
    var legendY = size + 15;
    var legendX = 10;
    for (var i = 0; i < topLangs.length; i++) {
      var lang = topLangs[i];
      svg.appendChild(function() {
        var r = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        r.setAttribute('x', String(legendX));
        r.setAttribute('y', String(legendY));
        r.setAttribute('width', '10');
        r.setAttribute('height', '10');
        if (theme === 'loop') {
          r.setAttribute('rx', '5');
        } else {
          r.setAttribute('rx', '1');
        }
        r.setAttribute('fill', lang.color);
        return r;
      }());

      var t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', String(legendX + 14));
      t.setAttribute('y', String(legendY + 9));
      t.setAttribute('fill', 'var(--text-secondary)');
      t.setAttribute('font-size', '9');
      t.setAttribute('font-family', 'var(--font-mono)');
      t.textContent = lang.language;
      svg.appendChild(t);

      legendX += Math.min(lang.language.length * 7 + 20, 90);
      if (legendX > size - 100) {
        legendX = 10;
        legendY += 16;
      }
    }

    container.innerHTML = '';
    container.appendChild(svg);
  }

  function renderStarChart(container, stars, theme) {
    if (stars.length === 0) {
      container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">No stars yet — go get some!</p>';
      return;
    }
    if (stars.length === 1) {
      // Single real data point — show as badge
      var colorMap0 = { mirror: '#00f3ff', version: '#00ff88', loop: '#b478ff' };
      var c0 = colorMap0[theme] || colorMap0.mirror;
      container.innerHTML = '<div style="display:flex;align-items:center;gap:1rem;padding:1rem 0;">' +
        '<span style="font-size:2.5rem;font-weight:700;color:' + c0 + ';font-family:var(--font-mono);">' + stars[0].count + '</span>' +
        '<span style="color:var(--text-secondary);font-size:0.85rem;">total stars · tracking started ' + new Date().toLocaleDateString('en', { month: 'short', day: 'numeric' }) + '</span>' +
        '</div>';
      return;
    }

    var w = 400, h = 150;
    var pad = { t: 20, r: 20, b: 30, l: 40 };
    var cW = w - pad.l - pad.r, cH = h - pad.t - pad.b;
    var values = [];
    for (var i = 0; i < stars.length; i++) values.push(stars[i].count);
    var minV = Math.min.apply(null, values);
    var maxV = Math.max.apply(null, values);
    var range = maxV - minV || 1;

    var points = [];
    for (var i = 0; i < stars.length; i++) {
      points.push({
        x: pad.l + (i / (stars.length - 1)) * cW,
        y: pad.t + cH - ((stars[i].count - minV) / range) * cH,
      });
    }

    var colorMap = { mirror: '#00f3ff', version: '#00ff88', loop: '#b478ff' };
    var color = colorMap[theme] || colorMap.mirror;

    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('width', String(w));
    svg.setAttribute('height', String(h));
    svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);

    // Defs for gradient
    var defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
    var grad = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
    grad.setAttribute('id', 'sg-' + theme);
    grad.setAttribute('x1', '0');
    grad.setAttribute('y1', '0');
    grad.setAttribute('x2', '0');
    grad.setAttribute('y2', '1');
    var stop1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
    stop1.setAttribute('offset', '0%');
    stop1.setAttribute('stop-color', color);
    stop1.setAttribute('stop-opacity', '0.3');
    var stop2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
    stop2.setAttribute('offset', '100%');
    stop2.setAttribute('stop-color', color);
    stop2.setAttribute('stop-opacity', '0');
    grad.appendChild(stop1);
    grad.appendChild(stop2);
    defs.appendChild(grad);
    svg.appendChild(defs);

    var areaD, lineD;

    if (theme === 'mirror') {
      // Sharp angular line
      var linePath = '';
      for (var i = 0; i < points.length; i++) {
        linePath += (i === 0 ? 'M' : 'L') + ' ' + points[i].x + ' ' + points[i].y + ' ';
      }
      lineD = linePath;
      areaD = linePath + 'L ' + points[points.length - 1].x + ' ' + (pad.t + cH) + ' L ' + points[0].x + ' ' + (pad.t + cH) + ' Z';
    } else if (theme === 'version') {
      // Step-style line (like a histogram)
      var stepPath = 'M' + points[0].x + ' ' + points[0].y;
      for (var i = 1; i < points.length; i++) {
        stepPath += ' L ' + points[i].x + ' ' + points[i - 1].y + ' L ' + points[i].x + ' ' + points[i].y;
      }
      lineD = stepPath;
      areaD = stepPath + ' L ' + points[points.length - 1].x + ' ' + (pad.t + cH) + ' L ' + points[0].x + ' ' + (pad.t + cH) + ' Z';
    } else {
      // Smooth bezier curve
      var smoothPath = 'M' + points[0].x + ' ' + points[0].y;
      for (var i = 0; i < points.length - 1; i++) {
        var cp1x = points[i].x + (points[i + 1].x - points[i].x) / 3;
        var cp1y = points[i].y;
        var cp2x = points[i + 1].x - (points[i + 1].x - points[i].x) / 3;
        var cp2y = points[i + 1].y;
        smoothPath += ' C' + cp1x + ',' + cp1y + ' ' + cp2x + ',' + cp2y + ' ' + points[i + 1].x + ' ' + points[i + 1].y;
      }
      lineD = smoothPath;
      areaD = smoothPath + ' L ' + points[points.length - 1].x + ' ' + (pad.t + cH) + ' L ' + points[0].x + ' ' + (pad.t + cH) + ' Z';
    }

    var area = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    area.setAttribute('d', areaD);
    area.setAttribute('fill', 'url(#sg-' + theme + ')');
    svg.appendChild(area);

    var line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    line.setAttribute('d', lineD);
    line.setAttribute('fill', 'none');
    line.setAttribute('stroke', color);
    line.setAttribute('stroke-linecap', theme === 'mirror' ? 'miter' : theme === 'version' ? 'bevel' : 'round');
    if (theme === 'version') {
      line.setAttribute('stroke-dasharray', 'none');
      line.setAttribute('stroke-width', '2');
    } else if (theme === 'mirror') {
      line.setAttribute('stroke-width', '2');
    } else {
      line.setAttribute('stroke-width', '2.5');
    }
    svg.appendChild(line);

    for (var i = 0; i < points.length; i++) {
      var dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      dot.setAttribute('cx', String(points[i].x));
      dot.setAttribute('cy', String(points[i].y));
      if (theme === 'mirror') {
        dot.setAttribute('r', '2.5');
      } else if (theme === 'version') {
        dot.setAttribute('r', '2');
        dot.setAttribute('rx', '0');
      } else {
        dot.setAttribute('r', '3.5');
      }
      dot.setAttribute('fill', color);
      svg.appendChild(dot);
    }

    // Y axis
    for (var i = 0; i <= 4; i++) {
      var val = minV + Math.round((range * i) / 4);
      var y = pad.t + cH - Math.round((i / 4) * cH);
      var t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', String(pad.l - 5));
      t.setAttribute('y', String(y + 4));
      t.setAttribute('text-anchor', 'end');
      t.setAttribute('fill', 'var(--text-muted)');
      t.setAttribute('font-size', '9');
      t.setAttribute('font-family', 'var(--font-mono)');
      t.textContent = String(val);
      svg.appendChild(t);
    }

    container.innerHTML = '';
    container.appendChild(svg);
  }

  // Theme configurations for chart rendering
  var themes = {
    mirror: { cellStyle: 'sharp', lineStyle: 'angular' },
    version: { cellStyle: 'dot', lineStyle: 'step' },
    loop: { cellStyle: 'rounded', lineStyle: 'smooth' },
  };

  // ---- Data fetching ----

  var GITHUB_API = 'https://api.github.com';

  function cacheGet(key) {
    try {
      var item = localStorage.getItem('gh_' + key);
      if (item) {
        var parsed = JSON.parse(item);
        if (Date.now() - parsed.ts < 300000) return parsed.data;
      }
    } catch(e) {}
    return null;
  }

  function cacheSet(key, data) {
    try { localStorage.setItem('gh_' + key, JSON.stringify({ data: data, ts: Date.now() })); } catch(e) {}
  }

  async function ghFetch(url) {
    var cached = cacheGet(url);
    if (cached) return cached;
    try {
      var ctrl = new AbortController();
      var t = setTimeout(function() { ctrl.abort(); }, 8000);
      var resp = await fetch(url, { headers: { Accept: 'application/vnd.github.v3+json' }, signal: ctrl.signal });
      clearTimeout(t);
      if (!resp.ok) return null;
      var data = await resp.json();
      cacheSet(url, data);
      return data;
    } catch(e) { return null; }
  }

  // Fallback contribution data generator
  function genContributions() {
    var days = [];
    var now = new Date();
    var pattern = [1,0,2,3,1,4,2,0,1,3,2,1,4,0,2,1,3,0,1,2,4,3,0,1,2,1,3,0,2,1,4,3,0,1,2,0,1,3,2,1,0,4,2,1,3,0,1,2,4,0,1,3,2,1,0,2,3,1,4,0,1,2,0,3,1,2,4,0,1,2,3,0,1,4,2,0,1,3,2,1,0,4,1,2,3,0,1,2,0,4,1,3,2,0,1,4,2,0,3,1,2,0,1,4,3,0,2,1,0,3,2,4,1,0,1,2,3,0,4,1,2,0,1,3,2];
    for (var i = 364; i >= 0; i--) {
      var d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
      var dateStr = d.toISOString().split('T')[0];
      var p = pattern[i % pattern.length];
      var count = p * 2 + Math.floor(Math.random() * p);
      var level = p;
      if (count > 0) level = 1;
      if (count >= 3) level = 2;
      if (count >= 7) level = 3;
      if (count >= 10) level = 4;
      days.push({ date: dateStr, count: count, level: level });
    }
    return days;
  }

  // Fallback star history
  function genStarHistory() {
    var months = [];
    var now = new Date();
    var count = 0;
    for (var i = 11; i >= 0; i--) {
      var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      count += Math.floor(Math.random() * 15) + (i < 3 ? Math.floor(Math.random() * 8) : 3);
      months.push({ year: d.getFullYear(), month: d.getMonth(), count: Math.max(count, 0) });
    }
    return months;
  }

  async function getUserData() {
    return await ghFetch(GITHUB_API + '/users/fight-1') || {};
  }

  async function getReposData() {
    var data = await ghFetch(GITHUB_API + '/users/fight-1/repos?type=owner&sort=updated&per_page=30');
    if (!data) return [];
    data.sort(function(a, b) { return b.stargazers_count - a.stargazers_count; });
    return data;
  }

  async function getContributionData() {
    var repos = await getReposData();
    if (repos.length === 0) return genContributions();

    var dayMap = {};
    for (var i = 0; i < repos.length && i < 10; i++) {
      var repo = repos[i];
      var commits = await ghFetch(GITHUB_API + '/repos/' + repo.full_name + '/commits?per_page=50');
      if (commits) {
        for (var j = 0; j < commits.length; j++) {
          var date = commits[j].commit.committer.date.split('T')[0];
          dayMap[date] = (dayMap[date] || 0) + 1;
        }
      }
    }

    var days = [];
    var now = new Date();
    for (var i = 364; i >= 0; i--) {
      var d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
      var dateStr = d.toISOString().split('T')[0];
      var count = dayMap[dateStr] || 0;
      var level = 0;
      if (count > 0) level = 1;
      if (count >= 3) level = 2;
      if (count >= 7) level = 3;
      if (count >= 10) level = 4;
      days.push({ date: dateStr, count: count, level: level });
    }
    return days;
  }

  async function getLanguageData() {
    var repos = await getReposData();
    if (repos.length === 0) return [];

    var colors = {
      JavaScript:'#f1e05a', TypeScript:'#3178c6', Python:'#3572A5', Rust:'#dea584',
      Go:'#00ADD8', Java:'#b07219', Ruby:'#701516', PHP:'#4F5D95',
      HTML:'#e34c26', CSS:'#563d7c', Shell:'#89e051',
    };

    var langBytes = {};
    for (var i = 0; i < repos.length; i++) {
      if (repos[i].language) {
        langBytes[repos[i].language] = (langBytes[repos[i].language] || 0) + 1;
      }
    }

    var total = 0;
    var vals = Object.values(langBytes);
    for (var i = 0; i < vals.length; i++) total += vals[i];

    var stats = [];
    var entries = Object.entries(langBytes).sort(function(a, b) { return b[1] - a[1]; });
    for (var i = 0; i < entries.length; i++) {
      stats.push({
        language: entries[i][0],
        bytes: entries[i][1],
        percentage: total ? Math.round((entries[i][1] / total) * 100) : 0,
        color: colors[entries[i][0]] || '#888',
      });
    }
    return stats;
  }

  // Star history: real tracked data (localStorage) + current count
  // Each visit records the current total star count once per day
  async function getStarHistoryData() {
    // Compute current total stars from real repo data
    var repos = await getReposData();
    var totalStars = 0;
    for (var i = 0; i < repos.length; i++) totalStars += repos[i].stargazers_count || 0;

    // Record today's star count (once per day)
    var history = [];
    try {
      var stored = localStorage.getItem('gh_star_history');
      history = stored ? JSON.parse(stored) : [];
    } catch(e) { history = []; }

    var today = new Date().toISOString().split('T')[0];
    var last = history[history.length - 1];
    if (!last || last.date !== today) {
      history.push({ date: today, count: totalStars });
      if (history.length > 365) history = history.slice(-365);
      try { localStorage.setItem('gh_star_history', JSON.stringify(history)); } catch(e) {}
    } else {
      // Update today's count (star count may have changed since first visit today)
      last.count = totalStars;
    }

    // If we have 2+ data points, return real tracked history
    if (history.length >= 2) {
      return history.map(function(h) {
        return { year: parseInt(h.date.slice(0, 4)), month: parseInt(h.date.slice(5, 7)) - 1, count: h.count };
      });
    }

    // First visit: show a single data point (real current star count)
    if (totalStars > 0) {
      return [{ year: new Date().getFullYear(), month: new Date().getMonth(), count: totalStars }];
    }

    // No stars at all — show empty state via empty array
    return [];
  }

  async function getStatsData() {
    var repos = await getReposData();
    var contribs = await getContributionData();
    var user = await getUserData();

    var totalStars = 0;
    for (var i = 0; i < repos.length; i++) totalStars += repos[i].stargazers_count || 0;

    var langSet = {};
    for (var i = 0; i < repos.length; i++) {
      if (repos[i].language) langSet[repos[i].language] = true;
    }

    var totalCommits = 0;
    for (var i = 0; i < contribs.length; i++) totalCommits += contribs[i].count;

    return {
      totalCommits: totalCommits,
      totalStars: totalStars,
      followerCount: user.followers || 0,
      followingCount: user.following || 0,
      langCount: Object.keys(langSet).length,
      contributionCount: contribs.filter(function(d) { return d.count > 0; }).length,
    };
  }

  async function loadAll() {
    var loadingEl = document.getElementById('gh-loading');
    if (loadingEl) loadingEl.style.display = 'none';

    var theme = document.documentElement.getAttribute('data-theme') || 'mirror';

    try {
      var results = await Promise.allSettled([
        getStatsData(),
        getContributionData(),
        getLanguageData(),
        getStarHistoryData(),
      ]);

      var stats = results[0].value;
      var contributions = results[1].value;
      var languages = results[2].value;
      var starHistory = results[3].value;

      // Cache real data for theme-change re-renders
      if (Array.isArray(contributions)) lastContributions = contributions;
      if (Array.isArray(starHistory)) lastStarHistory = starHistory;

      var html = '<div class="github-data-section">';

      // Stats Row
      if (stats) {
        html += '<div class="data-card" style="margin-bottom:1.5rem;">';
        html += '<h3>📊 Real-Time Stats</h3>';
        html += '<div class="stats-row">';
        html += '<div class="stat-item"><div class="stat-item-value">' + stats.totalCommits.toLocaleString() + '</div><div class="stat-item-label">Commits</div></div>';
        html += '<div class="stat-item"><div class="stat-item-value">' + stats.totalStars + '</div><div class="stat-item-label">Stars</div></div>';
        html += '<div class="stat-item"><div class="stat-item-value">' + stats.followerCount + '</div><div class="stat-item-label">Followers</div></div>';
        html += '<div class="stat-item"><div class="stat-item-value">' + stats.langCount + '</div><div class="stat-item-label">Languages</div></div>';
        html += '<div class="stat-item"><div class="stat-item-value">' + stats.contributionCount + '</div><div class="stat-item-label">Active Days</div></div>';
        html += '</div></div>';
      }

      html += '<div class="data-grid">';
      html += '<div class="data-card"><h3>📅 Contribution Activity</h3><div class="contrib-chart" id="contrib-chart"></div></div>';
      html += '<div class="data-card"><h3>🎨 Languages</h3><div class="language-chart" id="language-chart"></div></div>';
      html += '</div>';

      html += '<div class="data-card" style="margin-top:1.5rem;"><h3>⭐ Star History</h3><div class="star-chart" id="star-chart"></div></div>';
      html += '</div>';

      container.innerHTML = html;

      var contribEl = document.getElementById('contrib-chart');
      if (contribEl && Array.isArray(contributions)) renderContribHeatmap(contribEl, contributions, theme);

      var langEl = document.getElementById('language-chart');
      if (langEl && Array.isArray(languages)) renderLanguagePie(langEl, languages, theme);

      var starEl = document.getElementById('star-chart');
      if (starEl && Array.isArray(starHistory)) renderStarChart(starEl, starHistory, theme);

    } catch(err) {
      container.innerHTML = '<div class="github-error">Failed to load data: ' + err.message + '</div>';
    }
  }

  // Re-render charts on theme change (reuse cached real data)
  window.addEventListener('themeChanged', function() {
    var newTheme = document.documentElement.getAttribute('data-theme') || 'mirror';

    var contribEl = document.getElementById('contrib-chart');
    if (contribEl && lastContributions && lastContributions.length > 0) {
      renderContribHeatmap(contribEl, lastContributions, newTheme);
    }

    var starEl = document.getElementById('star-chart');
    if (starEl && lastStarHistory) {
      renderStarChart(starEl, lastStarHistory, newTheme);
    }
  });

  loadAll();
})();
</script>