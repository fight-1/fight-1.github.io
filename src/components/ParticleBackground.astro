---
// =========================================
// ParticleBackground.astro
// Canvas-based particle system
// =========================================
---

<style>
.particle-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
</style>

<canvas class="particle-canvas" id="particleCanvas" aria-hidden="true"></canvas>

<script client:load>
(function() {
  var canvas = document.getElementById('particleCanvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  var PARTICLE_COUNT = 80;
  var CONNECTION_DISTANCE = 120;
  var MOUSE_RADIUS = 150;
  var particles = [];
  var mouseX = -1000;
  var mouseY = -1000;
  var currentTheme = 'mirror';
  var dpr = window.devicePixelRatio || 1;

  function resize() {
    var parent = canvas.parentElement;
    var w = parent ? parent.clientWidth : window.innerWidth;
    var h = parent ? parent.clientHeight : window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function initParticles() {
    var w = canvas.width / dpr;
    var h = canvas.height / dpr;
    particles = [];
    for (var i = 0; i < PARTICLE_COUNT; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        size: Math.random() * 2 + 0.5,
        opacity: Math.random() * 0.5 + 0.2,
      });
    }
  }

  function getThemeColor(theme, alpha) {
    var colors = {
      mirror: 'rgba(0, 243, 255, ' + alpha + ')',
      version: 'rgba(0, 255, 136, ' + alpha + ')',
      loop: 'rgba(180, 120, 255, ' + alpha + ')',
    };
    return colors[theme] || colors.mirror;
  }

  function getThemeColorSecondary(theme, alpha) {
    var colors = {
      mirror: 'rgba(255, 0, 255, ' + alpha + ')',
      version: 'rgba(255, 170, 0, ' + alpha + ')',
      loop: 'rgba(120, 200, 255, ' + alpha + ')',
    };
    return colors[theme] || colors.mirror;
  }

  function animate() {
    var w = canvas.width / dpr;
    var h = canvas.height / dpr;
    ctx.clearRect(0, 0, w, h);

    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var dx = mouseX - p.x;
      var dy = mouseY - p.y;
      var dist = Math.sqrt(dx * dx + dy * dy);

      if (dist < MOUSE_RADIUS) {
        var force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS * 0.02;
        p.vx -= dx * force;
        p.vy -= dy * force;
      }

      p.x += p.vx;
      p.y += p.vy;
      p.vx *= 0.999;
      p.vy *= 0.999;

      if (p.x < 0) p.x = w;
      if (p.x > w) p.x = 0;
      if (p.y < 0) p.y = h;
      if (p.y > h) p.y = 0;

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = i % 2 === 0
        ? getThemeColor(currentTheme, p.opacity)
        : getThemeColorSecondary(currentTheme, p.opacity * 0.7);
      ctx.fill();

      for (var j = i + 1; j < particles.length; j++) {
        var p2 = particles[j];
        var d = Math.sqrt((p.x - p2.x) ** 2 + (p.y - p2.y) ** 2);
        if (d < CONNECTION_DISTANCE) {
          var alpha = (1 - d / CONNECTION_DISTANCE) * 0.15;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = getThemeColor(currentTheme, alpha);
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
    requestAnimationFrame(animate);
  }

  document.addEventListener('mousemove', function(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  window.addEventListener('themeChanged', function() {
    currentTheme = document.documentElement.getAttribute('data-theme') || 'mirror';
  });

  window.addEventListener('resize', function() {
    resize();
  });

  resize();
  initParticles();
  currentTheme = document.documentElement.getAttribute('data-theme') || 'mirror';
  animate();
})();
</script>