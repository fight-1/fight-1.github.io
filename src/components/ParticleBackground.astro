---
// =========================================
// ParticleBackground.astro
// Three completely different particle systems
// =========================================
---

<style>
.particle-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
</style>

<canvas class="particle-canvas" id="particleCanvas" aria-hidden="true"></canvas>

<script client:load>
(function() {
  var canvas = document.getElementById('particleCanvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  var PARTICLE_COUNT = 60;
  var CONNECTION_DISTANCE = 100;
  var MOUSE_RADIUS = 150;
  var particles = [];
  var mouseX = -1000;
  var mouseY = -1000;
  var currentTheme = 'mirror';
  var isMouseDown = false;
  var clickSparks = [];
  var animFrame = null;
  var dpr = window.devicePixelRatio || 1;

  // ---- Easter egg states ----
  var easterEggMode = 'none'; // 'none' | 'flame' | 'text'
  var easterEggTimer = null;
  var easterEggDuration = 8000; // 8 seconds
  var typedBuffer = '';
  var lastIdleTime = Date.now();
  var idleThreshold = 60000; // 60 seconds
  var textFormation = false;
  var textTargets = [];

  // Theme-specific configurations
  var themes = {
    mirror: {
      count: 80,
      connectionDist: 120,
      mouseRadius: 180,
      colorFn: getMirrorColor,
      particleSize: 1.5,
      lineWidth: 0.5,
      glow: true,
      speed: 0.5,
      drag: 0.995,
    },
    version: {
      count: 50,
      connectionDist: 130,
      mouseRadius: 150,
      colorFn: getVersionColor,
      particleSize: 6,
      lineWidth: 0.3,
      glow: false,
      speed: 0.3,
      drag: 0.98,
    },
    loop: {
      count: 100,
      connectionDist: 140,
      mouseRadius: 200,
      colorFn: getLoopColor,
      particleSize: 3,
      lineWidth: 0.8,
      glow: true,
      speed: 0.4,
      drag: 0.998,
    },
  };

  function getMirrorColor(alpha) {
    return 'rgba(0, 243, 255, ' + alpha + ')';
  }

  function getVersionColor(alpha) {
    return 'rgba(0, 255, 136, ' + alpha + ')';
  }

  function getLoopColor(alpha, idx) {
    var hue = 270 + (idx % 5) * 30;
    return 'hsla(' + hue + ', 80%, 68%, ' + alpha + ')';
  }

  // Flame color function
  function getFlameColor(alpha, idx) {
    var t = (Date.now() * 0.003 + idx * 0.1) % 1;
    var r = Math.floor(255);
    var g = Math.floor(100 + 155 * (1 - t));
    var b = Math.floor(50 * (1 - t));
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

  // Scan target points for text formation (simplified "fight-1")
  function getTextTargets(text, spacing) {
    var offscreen = document.createElement('canvas');
    var offCtx = offscreen.getContext('2d');
    var fontSize = Math.min(120, window.innerWidth / (text.length + 2));
    offscreen.width = window.innerWidth;
    offscreen.height = 200;
    offCtx.clearRect(0, 0, offscreen.width, offscreen.height);
    offCtx.fillStyle = 'white';
    offCtx.font = 'bold ' + fontSize + 'px Inter, sans-serif';
    offCtx.textAlign = 'center';
    offCtx.textBaseline = 'middle';
    offCtx.fillText(text, offscreen.width / 2, offscreen.height / 2);

    var imageData = offCtx.getImageData(0, 0, offscreen.width, offscreen.height);
    var targets = [];

    for (var y = 0; y < offscreen.height; y += spacing) {
      for (var x = 0; x < offscreen.width; x += spacing) {
        var i = (y * offscreen.width + x) * 4;
        if (imageData.data[i] > 128) {
          targets.push({ x: x, y: y });
        }
      }
    }
    return targets;
  }

  function resize() {
    var parent = canvas.parentElement;
    var w = parent ? parent.clientWidth : window.innerWidth;
    var h = parent ? parent.clientHeight : window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function initParticles(theme) {
    var cfg = themes[theme] || themes.mirror;
    var w = canvas.width / dpr;
    var h = canvas.height / dpr;
    PARTICLE_COUNT = cfg.count;
    CONNECTION_DISTANCE = cfg.connectionDist;
    MOUSE_RADIUS = cfg.mouseRadius;
    particles = [];
    for (var i = 0; i < PARTICLE_COUNT; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * cfg.speed,
        vy: (Math.random() - 0.5) * cfg.speed,
        size: cfg.particleSize + Math.random() * 2,
        opacity: Math.random() * 0.5 + 0.2,
        idx: i,
        phase: Math.random() * Math.PI * 2,
        pinned: false,
        pinX: 0,
        pinY: 0,
        pinTimer: 0,
        targetX: 0,
        targetY: 0,
        hasTarget: false,
        flamePhase: Math.random() * Math.PI * 2,
      });
    }
  }

  function drawThemeDot(p, theme) {
    var cfg = themes[theme];
    var color;

    if (easterEggMode === 'flame') {
      color = getFlameColor(p.opacity * 0.8, p.idx);
    } else {
      color = cfg.colorFn(p.opacity * 0.8, p.idx);
    }

    ctx.save();

    if (easterEggMode === 'flame') {
      // Flame particles: elongated upward, shimmering
      var flicker = Math.sin(Date.now() * 0.01 + p.flamePhase) * 2;
      var grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 2);
      grad.addColorStop(0, getFlameColor(p.opacity, p.idx));
      grad.addColorStop(0.5, getFlameColor(p.opacity * 0.5, p.idx + 5));
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      // Elongate upward
      ctx.ellipse(p.x, p.y - 3 + flicker, p.size * 0.6, p.size * 2, 0, 0, Math.PI * 2);
      ctx.fill();
    } else if (theme === 'mirror') {
      // Sharp diamond shapes
      ctx.translate(p.x, p.y);
      ctx.rotate(Math.PI / 4);
      ctx.fillStyle = color;
      if (cfg.glow) {
        ctx.shadowColor = color;
        ctx.shadowBlur = 10;
      }
      ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
    } else if (theme === 'version') {
      // Terminal block with cross-hair detail
      var s = p.size;
      ctx.fillStyle = color;
      ctx.fillRect(p.x - s / 2, p.y - s / 2, s, s);
      // Cross-hair detail
      ctx.strokeStyle = color;
      ctx.lineWidth = 0.5;
      ctx.globalAlpha = 0.4;
      ctx.beginPath();
      ctx.moveTo(p.x - s / 2, p.y);
      ctx.lineTo(p.x + s / 2, p.y);
      ctx.moveTo(p.x, p.y - s / 2);
      ctx.lineTo(p.x, p.y + s / 2);
      ctx.stroke();
      // Corner marks
      ctx.globalAlpha = 0.6;
      var corner = 2;
      ctx.beginPath();
      ctx.moveTo(p.x - s / 2, p.y - s / 2 + corner);
      ctx.lineTo(p.x - s / 2, p.y - s / 2);
      ctx.lineTo(p.x - s / 2 + corner, p.y - s / 2);
      ctx.moveTo(p.x + s / 2 - corner, p.y - s / 2);
      ctx.lineTo(p.x + s / 2, p.y - s / 2);
      ctx.lineTo(p.x + s / 2, p.y - s / 2 + corner);
      ctx.moveTo(p.x + s / 2, p.y + s / 2 - corner);
      ctx.lineTo(p.x + s / 2, p.y + s / 2);
      ctx.lineTo(p.x + s / 2 - corner, p.y + s / 2);
      ctx.moveTo(p.x - s / 2 + corner, p.y + s / 2);
      ctx.lineTo(p.x - s / 2, p.y + s / 2);
      ctx.lineTo(p.x - s / 2, p.y + s / 2 - corner);
      ctx.stroke();
    } else {
      // Soft circles with gradient
      var grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
      grad.addColorStop(0, cfg.colorFn(p.opacity, p.idx));
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();
  }

  function drawConnections(theme) {
    var cfg = themes[theme];

    if (easterEggMode === 'flame') {
      // Flame: no connections, just individual particles
      return;
    }

    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      for (var j = i + 1; j < particles.length; j++) {
        var p2 = particles[j];
        var dx = p.x - p2.x;
        var dy = p.y - p2.y;
        var d = Math.sqrt(dx * dx + dy * dy);

        if (d < CONNECTION_DISTANCE) {
          var alpha = (1 - d / CONNECTION_DISTANCE) * 0.12;
          var color;

          if (easterEggMode === 'text') {
            // Text mode: golden/white connections
            color = 'rgba(255, 215, 0, ' + alpha + ')';
          } else {
            color = cfg.colorFn(alpha, i + j);
          }

          ctx.save();
          ctx.strokeStyle = color;
          ctx.lineWidth = cfg.lineWidth;

          if (theme === 'mirror') {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          } else if (theme === 'version') {
            // PCB-style angular lines
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          } else {
            // Curved lines
            ctx.beginPath();
            var midX = (p.x + p2.x) / 2 + Math.sin(p.phase + Date.now() * 0.001) * 20;
            var midY = (p.y + p2.y) / 2 + Math.cos(p.phase + Date.now() * 0.001) * 20;
            ctx.quadraticCurveTo(midX, midY, p2.x, p2.y);
            ctx.stroke();
          }

          ctx.restore();
        }
      }
    }
  }

  function drawMouseTrail(theme) {
    var cfg = themes[theme];
    if (mouseX < -100 || mouseY < -100) return;

    ctx.save();
    var color;

    if (easterEggMode === 'flame') {
      color = 'rgba(255, 150, 0, 0.15)';
    } else {
      color = cfg.colorFn(0.15);
    }

    if (easterEggMode === 'flame') {
      // Flame: fire trail behind cursor
      var trailLen = 30;
      var grad = ctx.createLinearGradient(mouseX - trailLen, mouseY, mouseX + trailLen, mouseY);
      grad.addColorStop(0, 'rgba(255, 50, 0, 0)');
      grad.addColorStop(0.5, 'rgba(255, 150, 0, 0.08)');
      grad.addColorStop(1, 'rgba(255, 50, 0, 0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.ellipse(mouseX, mouseY, trailLen, 20, 0, 0, Math.PI * 2);
      ctx.fill();
    } else if (theme === 'mirror') {
      // Sharp triangle cursor
      ctx.translate(mouseX, mouseY);
      ctx.rotate(-Math.PI / 4);
      ctx.fillStyle = color;
      ctx.shadowColor = color;
      ctx.shadowBlur = 15;
      ctx.fillRect(-8, -8, 16, 16);
    } else if (theme === 'version') {
      // Terminal cursor: block + blinking cursor + data lines
      ctx.fillStyle = color;
      ctx.shadowColor = color;
      ctx.shadowBlur = 8;
      ctx.fillRect(mouseX - 3, mouseY - 12, 6, 24);
      if (Math.floor(Date.now() / 400) % 2 === 0) {
        ctx.fillStyle = 'rgba(0, 255, 136, 0.3)';
        ctx.fillRect(mouseX + 5, mouseY - 12, 1, 24);
      }
      if (isMouseDown) {
        ctx.strokeStyle = 'rgba(0, 255, 136, 0.2)';
        ctx.lineWidth = 1;
        for (var i = 0; i < 8; i++) {
          var angle = (Math.PI * 2 / 8) * i + Date.now() * 0.002;
          var len = 30 + Math.sin(Date.now() * 0.005 + i) * 15;
          ctx.beginPath();
          ctx.moveTo(mouseX, mouseY);
          ctx.lineTo(mouseX + Math.cos(angle) * len, mouseY + Math.sin(angle) * len);
          ctx.stroke();
        }
      }
    } else {
      // Soft glow orb
      var grad = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, MOUSE_RADIUS * 0.3);
      grad.addColorStop(0, cfg.colorFn(0.1, 0));
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(mouseX, mouseY, MOUSE_RADIUS * 0.3, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  // ---- Click sparks ----
  function spawnClickSparks(x, y, theme) {
    if (easterEggMode === 'flame') return; // No sparks in flame mode
    var count = theme === 'version' ? 16 : theme === 'mirror' ? 12 : 20;
    for (var i = 0; i < count; i++) {
      clickSparks.push({
        x: x,
        y: y,
        vx: (Math.random() - 0.5) * (theme === 'version' ? 6 : 8),
        vy: (Math.random() - 0.5) * (theme === 'version' ? 6 : 8),
        life: 1,
        decay: 0.02 + Math.random() * 0.03,
        size: theme === 'version' ? 3 + Math.random() * 4 : 2 + Math.random() * 3,
        theme: theme,
      });
    }
  }

  function updateAndDrawSparks() {
    if (clickSparks.length === 0) return;

    for (var i = clickSparks.length - 1; i >= 0; i--) {
      var s = clickSparks[i];
      s.x += s.vx;
      s.y += s.vy;
      s.vx *= 0.95;
      s.vy *= 0.95;
      s.life -= s.decay;

      if (s.life <= 0) {
        clickSparks.splice(i, 1);
        continue;
      }

      ctx.save();
      ctx.globalAlpha = s.life;

      if (s.theme === 'mirror') {
        ctx.translate(s.x, s.y);
        ctx.rotate(Math.PI / 4);
        ctx.fillStyle = '#00f3ff';
        ctx.shadowColor = '#00f3ff';
        ctx.shadowBlur = 6;
        ctx.fillRect(-s.size / 2, -s.size / 2, s.size, s.size);
      } else if (s.theme === 'version') {
        ctx.fillStyle = '#00ff88';
        ctx.fillRect(s.x - s.size / 2, s.y - s.size / 2, s.size, s.size);
        ctx.strokeStyle = '#00ff88';
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(s.x - s.size / 3, s.y);
        ctx.lineTo(s.x + s.size / 3, s.y);
        ctx.moveTo(s.x, s.y - s.size / 3);
        ctx.lineTo(s.x, s.y + s.size / 3);
        ctx.stroke();
      } else {
        var grad = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.size);
        grad.addColorStop(0, 'hsla(' + (270 + Math.random() * 60) + ', 80%, 68%, ' + s.life + ')');
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
    }
  }

  function animate() {
    var cfg = themes[currentTheme];
    var w = canvas.width / dpr;
    var h = canvas.height / dpr;
    ctx.clearRect(0, 0, w, h);

    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];

      if (easterEggMode === 'flame') {
        // ---- FLAME MODE ----
        // Particles float upward like flames with random turbulence
        p.vy -= 0.05 + Math.random() * 0.08;
        p.vx += (Math.random() - 0.5) * 0.3;
        p.vy *= 0.98;
        p.vx *= 0.98;

        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < -10) {
          p.y = h + 10;
          p.x = Math.random() * w;
        }
      } else if (easterEggMode === 'text') {
        // ---- TEXT FORMATION MODE ----
        if (!p.hasTarget) {
          // Find nearest unassigned target
          var bestDist = Infinity;
          var bestIdx = -1;
          for (var j = 0; j < textTargets.length; j++) {
            if (textTargets[j].assigned) continue;
            var d = Math.sqrt((p.x - textTargets[j].x) ** 2 + (p.y - textTargets[j].y) ** 2);
            if (d < bestDist) {
              bestDist = d;
              bestIdx = j;
            }
          }
          if (bestIdx !== -1) {
            textTargets[bestIdx].assigned = true;
            p.targetX = textTargets[bestIdx].x;
            p.targetY = textTargets[bestIdx].y;
            p.hasTarget = true;
          }
        }

        if (p.hasTarget) {
          // Ease toward target
          var tdx = p.targetX - p.x;
          var tdy = p.targetY - p.y;
          p.vx += tdx * 0.04;
          p.vy += tdy * 0.04;
          p.vx *= 0.85;
          p.vy *= 0.85;
        } else {
          // Idle floating
          p.x += p.vx;
          p.y += p.vy;
          p.vx *= cfg.drag;
          p.vy *= cfg.drag;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;
        }
      } else {
        // ---- NORMAL MODE (per theme) ----
        var dx = mouseX - p.x;
        var dy = mouseY - p.y;
        var dist = Math.sqrt(dx * dx + dy * dy);

        if (currentTheme === 'mirror' && dist < MOUSE_RADIUS) {
          var force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS * 0.03;
          p.vx -= dx * force;
          p.vy -= dy * force;
        } else if (currentTheme === 'version' && dist < MOUSE_RADIUS) {
          if (dist < 20) {
            if (!p.pinned) {
              p.pinX = p.x;
              p.pinY = p.y;
              p.pinned = true;
            }
            p.pinTimer++;
            p.x = p.pinX + (Math.random() - 0.5) * 2;
            p.y = p.pinY + (Math.random() - 0.5) * 2;
            p.vx = 0;
            p.vy = 0;
            if (p.pinTimer > 60 + Math.random() * 30) {
              p.pinned = false;
              p.pinTimer = 0;
              p.vx = (Math.random() - 0.5) * cfg.speed;
              p.vy = (Math.random() - 0.5) * cfg.speed;
            }
          } else if (dist < 60) {
            var angle = Math.atan2(dy, dx);
            var orbitSpeed = 0.02 * (1 - dist / 60);
            p.vx += Math.cos(angle + Math.PI / 2) * orbitSpeed;
            p.vy += Math.sin(angle + Math.PI / 2) * orbitSpeed;
            p.vx -= dx * 0.0003;
            p.vy -= dy * 0.0003;
          } else if (dist < MOUSE_RADIUS) {
            var gridSize = 20;
            if (!p.pinned) {
              p.vx += Math.round(p.vx / (gridSize / 10)) * (gridSize / 10) * 0.02;
              p.vy += Math.round(p.vy / (gridSize / 10)) * (gridSize / 10) * 0.02;
            }
          }
        } else if (currentTheme === 'loop' && dist < MOUSE_RADIUS) {
          var force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS * 0.005;
          p.vx += dx * force;
          p.vy += dy * force;
        }

        if (currentTheme === 'loop') {
          p.x += Math.sin(Date.now() * 0.001 + p.phase) * 0.2;
          p.y += Math.cos(Date.now() * 0.0013 + p.phase) * 0.2;
        }

        p.x += p.vx;
        p.y += p.vy;
        p.vx *= cfg.drag;
        p.vy *= cfg.drag;

        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;
      }
    }

    drawConnections(currentTheme);

    for (var i = 0; i < particles.length; i++) {
      drawThemeDot(particles[i], currentTheme);
    }

    drawMouseTrail(currentTheme);
    updateAndDrawSparks();

    animFrame = requestAnimationFrame(animate);
  }

  // ---- Easter egg activation ----
  function activateFlame() {
    if (easterEggTimer) clearTimeout(easterEggTimer);
    easterEggMode = 'flame';

    // Visual feedback: brief screen flash
    var flash = document.createElement('div');
    flash.style.cssText = 'position:fixed;inset:0;background:rgba(255,100,0,0.15);z-index:9999;pointer-events:none;animation:fadeInUp 0.2s ease both;';
    document.body.appendChild(flash);
    setTimeout(function() {
      flash.style.transition = 'opacity 0.5s';
      flash.style.opacity = '0';
      setTimeout(function() { flash.remove(); }, 500);
    }, 300);

    // Update theme label
    var hintEl = document.querySelector('.theme-label-hint');
    if (hintEl) {
      hintEl.textContent = '🔥 Flame mode!';
      setTimeout(function() { hintEl.textContent = '🔥 Press T to switch'; }, 3000);
    }

    easterEggTimer = setTimeout(function() {
      easterEggMode = 'none';
      // Reinit particles to normal
      var theme = document.documentElement.getAttribute('data-theme') || 'mirror';
      initParticles(theme);
    }, easterEggDuration);
  }

  function activateTextFormation() {
    if (easterEggTimer) clearTimeout(easterEggTimer);
    easterEggMode = 'text';
    textTargets = getTextTargets('fight-1', 8);
    textFormation = true;

    // Brief flash
    var flash = document.createElement('div');
    flash.style.cssText = 'position:fixed;inset:0;background:rgba(255,215,0,0.08);z-index:9999;pointer-events:none;';
    document.body.appendChild(flash);
    setTimeout(function() {
      flash.style.transition = 'opacity 0.8s';
      flash.style.opacity = '0';
      setTimeout(function() { flash.remove(); }, 800);
    }, 400);

    var hintEl = document.querySelector('.theme-label-hint');
    if (hintEl) {
      hintEl.textContent = '📝 Text mode!';
      setTimeout(function() { hintEl.textContent = '📝 Press T to switch'; }, 3000);
    }

    easterEggTimer = setTimeout(function() {
      easterEggMode = 'none';
      textFormation = false;
      textTargets = [];
      for (var i = 0; i < textTargets.length; i++) textTargets[i].assigned = false;
      var theme = document.documentElement.getAttribute('data-theme') || 'mirror';
      initParticles(theme);
    }, easterEggDuration);
  }

  function resetIdleTimer() {
    lastIdleTime = Date.now();
    if (easterEggMode === 'text') {
      // User interacted, cancel text formation
      if (easterEggTimer) clearTimeout(easterEggTimer);
      easterEggMode = 'none';
      textFormation = false;
      textTargets = [];
      for (var i = 0; i < textTargets.length; i++) {
        if (textTargets[i]) textTargets[i].assigned = false;
      }
      var theme = document.documentElement.getAttribute('data-theme') || 'mirror';
      initParticles(theme);
    }
  }

  // ---- Input buffer for "fight" ----
  document.addEventListener('keydown', function(e) {
    // Track typed characters (only alphanumeric)
    if (e.key.length === 1) {
      typedBuffer += e.key.toLowerCase();
      if (typedBuffer.length > 20) {
        typedBuffer = typedBuffer.slice(-20);
      }
    }

    // Check for "fight"
    if (typedBuffer.indexOf('fight') !== -1 && easterEggMode !== 'flame') {
      activateFlame();
      typedBuffer = '';
    }

    // Clean buffer: if it doesn't contain "fight" as substring anymore
    // Actually just keep checking
    if (!typedBuffer.includes('fight')) {
      // Check if last chars still have potential
      var last5 = typedBuffer.slice(-5);
      if (last5.length > 0 && !last5.startsWith('f')) {
        typedBuffer = '';
      }
    }
  });

  // ---- Idle detection ----
  function checkIdle() {
    if (easterEggMode !== 'none' && easterEggMode !== 'text') return;
    var idle = Date.now() - lastIdleTime;
    if (idle >= idleThreshold) {
      activateTextFormation();
    }
    requestAnimationFrame(checkIdle);
  }

  document.addEventListener('mousemove', function(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
    resetIdleTimer();
  });

  document.addEventListener('mousedown', function() {
    isMouseDown = true;
  });

  document.addEventListener('mouseup', function() {
    isMouseDown = false;
  });

  document.addEventListener('click', function(e) {
    spawnClickSparks(e.clientX, e.clientY, currentTheme);
    resetIdleTimer();
  });

  document.addEventListener('keydown', resetIdleTimer);
  document.addEventListener('scroll', resetIdleTimer);

  window.addEventListener('themeChanged', function() {
    var newTheme = document.documentElement.getAttribute('data-theme') || 'mirror';
    if (newTheme !== currentTheme) {
      currentTheme = newTheme;
      initParticles(newTheme);
    }
  });

  window.addEventListener('resize', function() {
    resize();
    initParticles(currentTheme);
    // Rebuild text targets if active
    if (easterEggMode === 'text') {
      textTargets = getTextTargets('fight-1', 8);
    }
  });

  resize();
  currentTheme = document.documentElement.getAttribute('data-theme') || 'mirror';
  initParticles(currentTheme);
  animate();

  // Start idle checker
  requestAnimationFrame(checkIdle);
})();
</script>